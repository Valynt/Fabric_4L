      "gate_id": "design.acceptance_criteria",
      "version": 1,
      "name": "Design acceptance criteria defined",
      "scope": "design",
      "criticality": "blocking",
      "protected_invariant": "Critical behavior is expressed as testable acceptance criteria before implementation begins.",
      "applies_when": "Any change touches product-visible behavior, security boundaries, data models, or workflow states.",
      "measurement": {
        "type": "manual_review",
        "source": "design-rfc-or-issue",
        "query_or_command": "Verify acceptance criteria, threat model, migration/rollback plan, and observability plan are present in the design artifact.",
        "threshold": "All required sections present and reviewed"
      },
      "pass_criteria": [
        "Acceptance criteria are explicit and testable",
        "Affected contracts are listed",
        "Threat model is updated for security changes",
        "Migration and rollback strategies are documented"
      ],
      "fail_criteria": [
        "Critical behavior is expressed only as narrative",
        "No rollback strategy exists",
        "Security change lacks threat-model update"
      ],
      "inconclusive_criteria": [
        "Design artifact exists but required sections are missing",
        "Review is pending"
      ],
      "not_applicable_criteria": [
        "Pure refactor with no observable behavior change"
      ],
      "warning_criteria": [
        "Observability plan deferred but owner assigned"
      ],
      "evidence": {
        "required": true,
        "artifact_binding": "commit-sha",
        "maximum_age": "release",
        "retention": "1y",
        "required_fields": ["design_artifact_uri", "reviewer_identity", "acceptance_criteria_count"]
      },
      "enforcement_point": "design-approval",
      "failure_action": "block",
      "owner": "value-fabric/architects",
      "approvers": ["value-fabric/architects", "value-fabric/security-leads"],
      "override_policy": "requires_architect",
      "review_cadence": "quarterly",
      "deprecation_policy": "Superseded by design.acceptance_criteria.v2 when contract coverage model changes."
    },
