+# =============================================================================
+# PATCH-005: Critical Frontend Coverage Gates
+# Enforces enterprise-grade test coverage thresholds before deployment.
+# Targets: 70% lines, 60% branches, 65% functions, 65% statements.
+# =============================================================================
+name: critical-gates
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "apps/web/src/**"
+      - "apps/web/test/**"
+      - "apps/web/**/*.config.ts"
+  pull_request:
+    branches: [main]
+    paths:
+      - "apps/web/src/**"
+      - "apps/web/test/**"
+      - "apps/web/**/*.config.ts"
+
+jobs:
+  coverage-gate:
+    name: Frontend Coverage Gate
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: apps/web
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+          cache: "pnpm"
+
+      - name: Install dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Run unit tests with coverage
+        run: pnpm run test:coverage
+
+      - name: Upload coverage report
+        uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: coverage-report
+          path: apps/web/coverage/
+          retention-days: 14
+
+      - name: Enforce coverage thresholds
+        run: |
+          echo "Checking coverage thresholds..."
+          # The vitest config has reportOnFailure: true, so the test:coverage
+          # command above already fails if thresholds are not met.
+          # This step provides a clear error message for developers.
+          if [ $? -ne 0 ]; then
+            echo "ERROR: Coverage thresholds not met."
+            echo "Required: lines >= 70%, branches >= 60%, functions >= 65%, statements >= 65%"
+            echo "Run 'pnpm run test:coverage' locally to see the full report."
+            exit 1
+          fi
