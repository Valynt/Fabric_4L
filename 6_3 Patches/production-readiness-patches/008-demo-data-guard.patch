+#!/usr/bin/env node
+/**
+ * PATCH-008: Production Demo Data Security Gate
+ *
+ * Scans the production bundle for real customer names that should
+ * never appear in production builds. Fails CI if any are found.
+ *
+ * Usage:
+ *   node scripts/security/assert-no-demo-data-in-production.mjs
+ *
+ * Prerequisite: Run `pnpm run build` first so dist/public exists.
+ */
+
+import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { join, relative } from "node:path";
+
+const projectRoot = new URL("../..", import.meta.url).pathname;
+const distRoots = [
+  join(projectRoot, "dist/public"),
+  join(projectRoot, "dist"),
+].filter(existsSync);
+
+if (distRoots.length === 0) {
+  console.error("Production bundle not found. Run pnpm run build before this assertion.");
+  process.exit(1);
+}
+
+// Known customer names from fixtures — must NEVER appear in production bundles.
+const BLOCKED_CUSTOMER_NAMES = [
+  "Medtronic",
+  "Stryker",
+  "Baxter",
+  "Johnson & Johnson MedTech",
+  "Finastra",
+  "Goldman Sachs",
+];
+
+// File extensions to scan in the production bundle.
+const TEXT_EXTENSIONS = new Set([
+  ".css", ".html", ".js", ".json", ".map", ".mjs", ".svg", ".txt", ".xml",
+]);
+
+function getExtension(path) {
+  const match = /\.[^.]+$/.exec(path);
+  return match ? match[0] : "";
+}
+
+function walkDirectory(dir, files = []) {
+  for (const entry of readdirSync(dir)) {
+    const entryPath = join(dir, entry);
+    const stat = statSync(entryPath);
+    if (stat.isDirectory()) {
+      walkDirectory(entryPath, files);
+    } else if (TEXT_EXTENSIONS.has(getExtension(entryPath))) {
+      files.push(entryPath);
+    }
+  }
+  return files;
+}
+
+const violations = [];
+
+for (const root of distRoots) {
+  for (const file of walkDirectory(root)) {
+    const body = readFileSync(file, "utf8");
+    for (const name of BLOCKED_CUSTOMER_NAMES) {
+      if (body.includes(name)) {
+        violations.push(`${relative(projectRoot, file)} contains "${name}"`);
+      }
+    }
+  }
+}
+
+if (violations.length > 0) {
+  console.error("[PATCH-008] PRODUCTION BUNDLE CONTAINS DEMO CUSTOMER DATA:");
+  console.error("The following real customer names were found in the production bundle:");
+  for (const violation of violations) {
+    console.error(`  - ${violation}`);
+  }
+  console.error("\nRemediation: Ensure all demo data imports are gated behind import.meta.env.DEV.");
+  console.error("See: apps/web/src/test/fixtures/demo-prospects.ts");
+  process.exit(1);
+}
+
+console.log("[PATCH-008] Production bundle contains no demo customer data.");

