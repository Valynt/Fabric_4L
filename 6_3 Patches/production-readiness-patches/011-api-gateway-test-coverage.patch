+# ---------------------------------------------------------------------------
+# 11. Error Envelope Consistency
+# ---------------------------------------------------------------------------

+
+class TestErrorEnvelopeConsistency:
+    """All error responses must follow the canonical error envelope format."""
+
+    def _assert_canonical_error(self, response: Any, expected_status: int) -> None:
+        """Validate that error response follows the canonical envelope."""
+        assert response.status_code == expected_status
+        data = response.json()
+        assert isinstance(data, dict), "Error body must be a JSON object"
+        assert "detail" in data, "Error body must have 'detail' key"
+        detail = data["detail"]
+        if isinstance(detail, dict):
+            assert "error_code" in detail, "Error detail must have 'error_code'"
+            assert isinstance(detail["error_code"], str), "error_code must be a string"
+
+    def test_401_error_envelope(self) -> None:
+        """401 Unauthorized must follow canonical error format."""
+        with TestClient(app) as client:
+            response = client.get("/v1/accounts")
+        self._assert_canonical_error(response, 401)
+
+    def test_403_error_envelope(self) -> None:
+        """403 Forbidden must follow canonical error format."""
+        token = mint_token(tenant_id=TENANT_ALPHA, roles=["analyst"])
+        with TestClient(app) as client:
+            response = client.get(
+                "/v1/admin/users",
+                headers={"Authorization": f"Bearer {token}"},
+            )
+        if response.status_code == 403:
+            self._assert_canonical_error(response, 403)
+
+    def test_404_error_envelope(self) -> None:
+        """404 Not Found must follow canonical error format."""
+        with TestClient(app) as client:
+            response = client.get(
+                "/v1/accounts/nonexistent-entity-12345",
+                headers=auth_headers(TENANT_ALPHA),
+            )
+        if response.status_code == 404:
+            self._assert_canonical_error(response, 404)
+
+    def test_422_error_envelope(self) -> None:
+        """422 Validation Error must follow canonical error format."""
+        with TestClient(app) as client:
+            response = client.post(
+                "/v1/accounts",
+                json={"invalid_field": "no id"},
+                headers=auth_headers(TENANT_ALPHA),
+            )
+        if response.status_code == 422:
+            data = response.json()
+            assert isinstance(data, dict)
+            assert "detail" in data
+
+    def test_500_error_envelope(self) -> None:
+        """500 Internal Server Error must follow canonical error format."""
+        # Simulate a server error by mocking a dependency
+        from unittest.mock import patch
+        with patch("app.routers.accounts.get_account_service") as mock_svc:
+            mock_svc.side_effect = RuntimeError("simulated failure")
+            with TestClient(app) as client:
+                response = client.get(
+                    "/v1/accounts",
+                    headers=auth_headers(TENANT_ALPHA),
+                )
+        # Server errors should be caught by exception handlers
+        assert response.status_code in (200, 500)
+        if response.status_code == 500:
+            self._assert_canonical_error(response, 500)


+# ---------------------------------------------------------------------------
+# conftest helper extension for RBAC tests
+# ---------------------------------------------------------------------------
+
+# The mint_token function in conftest.py needs a `roles` parameter.
+# Add the following to the mint_token signature if not already present:
+#     roles: list[str] | None = None
+# And include roles in the JWT payload:
+#     if roles:
+#         payload["roles"] = roles
+
+
+def mint_token_with_roles(
+    tenant_id: str = TENANT_ALPHA,
+    roles: list[str] | None = None,
+    expires_delta: timedelta = timedelta(hours=1),
+) -> str:
+    """Mint a test JWT with explicit role claims."""
+    from .conftest import TEST_AUDIENCE, TEST_ISSUER, mint_token as _mint_token
+    # If conftest mint_token already supports roles, delegate to it
+    try:
+        return _mint_token(tenant_id=tenant_id, roles=roles, expires_delta=expires_delta)
+    except TypeError:
+        # Fallback: mint manually if conftest does not support roles yet
+        settings = get_settings()
+        now = int(datetime.now(UTC).timestamp())
+        payload = {
+            "sub": "test-user-rbac",
+            "tenant_id": tenant_id,
+            "iss": TEST_ISSUER,
+            "aud": TEST_AUDIENCE,
+            "iat": now,
+            "nbf": now,
+            "exp": now + int(expires_delta.total_seconds()),
+            "jti": f"test-jti-rbac-{tenant_id}-{now}",
+        }
+        if roles:
+            payload["roles"] = roles
+        return jwt.encode(payload, settings.secret_key, algorithm=settings.algorithm)
