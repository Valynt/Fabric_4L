{
  "schema_version": 1,
  "canonical_check": {
    "workflow_path": ".github/workflows/security-gates.yml",
    "workflow_name": "Security Gates",
    "job_id": "mandatory-security-regression",
    "check_context": "mandatory-security-regression",
    "github_app_id": 15368,
    "timeout_minutes": 45
  },
  "pull_request": {
    "base_branches": ["main"],
    "path_filters_permitted": false
  },
  "branch_protection": {
    "branch": "main",
    "strict": true,
    "enforce_administrators": true,
    "require_code_owner_reviews": true,
    "required_approving_review_count": 1,
    "require_conversation_resolution": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "bypass_actors": []
  },
  "codeowners": [
    ".github/CODEOWNERS",
    ".github/workflows/security-gates.yml",
    ".github/workflows/branch-protection-validation.yml",
    "config/ci/",
    "scripts/ci/mandatory_security_regression_gate.sh",
    "scripts/ci/check_mandatory_security_gate_contract.py",
    "scripts/ci/validate_mandatory_security_gate_enforcement.py",
    "docs/governance/branch-protection-required-checks.yml",
    "docs/governance/mandatory-security-regression-merge-policy.md",
    "docs/governance/incidents/",
    "docs/validation/security_regression/"
  ]
}
