+
+
+  # ---------------------------------------------------------------------------
+  # V1-CI-001 Stage 1 (shadow): stable aggregate PR checks. Aggregate jobs
+  # perform no substantive testing; they only summarize the results of the
+  # existing jobs they fan in from (scripts/ci/aggregate_gate.py). They are
+  # informational until Stage 3 makes them required after shadow parity.
+  # A 'skipped' child only passes when the skip is explicitly confirmed safe
+  # via a SKIPSAFE_* env expression (change-scope output resolved to 'false'
+  # or the job's event gate does not apply to this event).
+  # ---------------------------------------------------------------------------
+  aggregate-01-repository-integrity:
+    name: 01-repository-integrity
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    if: always()
+    needs:
+      - change-scope
+      - structural-preflight
+      - pr-overlap-guard
+      - governance-docs-check
+      - gate-engineering
+    steps:
+      - uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332 # v4
+      - name: Summarize repository-integrity gates
+        env:
+          NEEDS_JSON: ${{ toJSON(needs) }}
+          # pr-overlap-guard only runs on pull_request events; on push and
+          # merge_group there is no overlapping PR to guard against.
+          SKIPSAFE_PR_OVERLAP_GUARD: ${{ github.event_name != 'pull_request' }}
+        run: |
+          python3 scripts/ci/aggregate_gate.py \
+            --needs-json "$NEEDS_JSON" \
+            --skip-safe pr-overlap-guard=SKIPSAFE_PR_OVERLAP_GUARD
+
+  aggregate-02-code-quality-and-tests:
+    name: 02-code-quality-and-tests
