+        run: |
+          python3 scripts/ci/aggregate_gate.py \
+            --needs-json "$NEEDS_JSON" \
+            --skip-safe sbom-scan=SKIPSAFE_IMAGE_CERT \
+            --skip-safe provenance=SKIPSAFE_IMAGE_CERT \
+            --skip-safe verify-signatures=SKIPSAFE_IMAGE_CERT
