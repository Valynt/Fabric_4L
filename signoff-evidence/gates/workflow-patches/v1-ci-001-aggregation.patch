+      - layer2-checks
+      - layer3-checks
+      - layer4-checks
+      - layer5-checks
+      - layer6-checks
+      - shared-and-tests-checks
+      - frontend-checks
+    steps:
+      - uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332 # v4
+      - name: Summarize code-quality and test gates
+        env:
+          NEEDS_JSON: ${{ toJSON(needs) }}
+          SKIPSAFE_LAYER1: ${{ needs.change-scope.outputs.layer1 == 'false' }}
+          SKIPSAFE_LAYER2: ${{ needs.change-scope.outputs.layer2 == 'false' }}
+          SKIPSAFE_LAYER3: ${{ needs.change-scope.outputs.layer3 == 'false' }}
+          SKIPSAFE_LAYER4: ${{ needs.change-scope.outputs.layer4 == 'false' }}
+          SKIPSAFE_LAYER5: ${{ needs.change-scope.outputs.layer5 == 'false' }}
+          SKIPSAFE_LAYER6: ${{ needs.change-scope.outputs.layer6 == 'false' }}
+          SKIPSAFE_BACKEND: ${{ needs.change-scope.outputs.backend == 'false' }}
+          SKIPSAFE_WEB: ${{ needs.change-scope.outputs.web == 'false' }}
+        run: |
+          python3 scripts/ci/aggregate_gate.py \
+            --needs-json "$NEEDS_JSON" \
+            --skip-safe layer1-checks=SKIPSAFE_LAYER1 \
+            --skip-safe layer2-checks=SKIPSAFE_LAYER2 \
+            --skip-safe layer3-checks=SKIPSAFE_LAYER3 \
+            --skip-safe layer4-checks=SKIPSAFE_LAYER4 \
+            --skip-safe layer5-checks=SKIPSAFE_LAYER5 \
+            --skip-safe layer6-checks=SKIPSAFE_LAYER6 \
+            --skip-safe shared-and-tests-checks=SKIPSAFE_BACKEND \
+            --skip-safe frontend-checks=SKIPSAFE_WEB
+
+  aggregate-05-tenant-isolation-and-behavior:
+    name: 05-tenant-isolation-and-behavior
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    if: always()
+    needs:
+      - change-scope
+      - behavior-tests
+      - tenant-isolation-gate
+      - route-auth-gate
+      - layer5-source-contract
+      - layer5-tenant-isolation-regression
+      - layer5-contract-shape-regression
+      - critical-behaviors-gate
+    steps:
+      - uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332 # v4
+      - name: Summarize tenant-isolation and behavior gates
+        env:
+          NEEDS_JSON: ${{ toJSON(needs) }}
+          SKIPSAFE_WEB: ${{ needs.change-scope.outputs.web == 'false' }}
+          SKIPSAFE_BACKEND: ${{ needs.change-scope.outputs.backend == 'false' }}
+          SKIPSAFE_LAYER5: ${{ needs.change-scope.outputs.layer5 == 'false' }}
+          SKIPSAFE_CODE: ${{ needs.change-scope.outputs.code == 'false' }}
+        run: |
+          python3 scripts/ci/aggregate_gate.py \
+            --needs-json "$NEEDS_JSON" \
+            --skip-safe behavior-tests=SKIPSAFE_WEB \
+            --skip-safe tenant-isolation-gate=SKIPSAFE_BACKEND \
+            --skip-safe route-auth-gate=SKIPSAFE_BACKEND \
+            --skip-safe layer5-source-contract=SKIPSAFE_LAYER5 \
+            --skip-safe layer5-tenant-isolation-regression=SKIPSAFE_LAYER5 \
+            --skip-safe layer5-contract-shape-regression=SKIPSAFE_LAYER5 \
+            --skip-safe critical-behaviors-gate=SKIPSAFE_CODE
+
+  # 09-change-risk-and-approval is deterministic policy, not an LLM gate and
+  # not a fan-in summary: it verifies that a schema-valid independent-review
+  # artifact exists for the exact base/head SHAs under review, has no
