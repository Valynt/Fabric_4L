{
  "name": "Value Fabric Development Environment",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace/Fabric_4L",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/python@sha256:fbcad6955caeecc5ad3f7886baf652e25cba5225a6c4c2287c536de2e5607511": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/node@sha256:fedd4c11f7adfb64283b578dddc7da906728daa25fa293351c9d913231acf12f": {
      "version": "22.22.2",
      "pnpmVersion": "10.34.5"
    },
    "ghcr.io/devcontainers/features/github-cli@sha256:d22f50b70ed75339b4eed1ba9ecde3a1791f90e88d37936517e3bace0bbad671": {}
  },
  "postCreateCommand": "/workspace/Fabric_4L/.devcontainer/post-create.sh",
  "postStartCommand": "/workspace/Fabric_4L/.devcontainer/post-start.sh",
  "forwardPorts": [3001, 8001, 8002, 8003, 8004, 8005, 8006, 8007],
  "portsAttributes": {
    "3001": { "label": "Frontend", "onAutoForward": "notify" },
    "8001": { "label": "Layer 1: Ingestion" },
    "8002": { "label": "Layer 2: Extraction" },
    "8003": { "label": "Layer 3: Knowledge" },
    "8004": { "label": "Layer 4: Agents" },
    "8005": { "label": "Layer 5: Ground Truth" },
    "8006": { "label": "Layer 6: Benchmarks" },
    "8007": { "label": "Layer 2.5: Signal Refinery" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python",
        "python.terminal.activateEnvironment": false,
        "eslint.workingDirectories": [{ "mode": "auto" }],
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
