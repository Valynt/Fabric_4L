{
  "name": "Fabric 4L Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.18.1 --activate && pnpm install --frozen-lockfile && make setup && cp .env.example .env",
  "postStartCommand": "docker compose -f infra/compose/docker-compose.dev.yml up -d && make migrate",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright"
      ]
    }
  },
  "forwardPorts": [5173, 8001, 8002, 8003, 8004, 8005, 8006, 5432, 6379, 7474],
  "portsAttributes": {
    "5173": { "label": "Frontend" },
    "8001": { "label": "Layer 1: Ingestion" },
    "8002": { "label": "Layer 2: Extraction" },
    "8003": { "label": "Layer 3: Knowledge" },
    "8004": { "label": "Layer 4: Agents" },
    "8005": { "label": "Layer 5: Ground Truth" },
    "8006": { "label": "Layer 6: Benchmarks" }
  }
}
