# Fabric4L Full Stack - Local Development Environment
# Generated for local testing with dev auth bypass

# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=valuefabric
REDIS_PASSWORD=dev-redis-password

# API Keys (placeholders for dev)
OPENAI_API_KEY=sk-dev-placeholder
TOGETHER_API_KEY=dev-placeholder
ANTHROPIC_API_KEY=dev-placeholder

# Auth (dev bypass)
JWT_SECRET=dev-local-secret-do-not-use-in-production-minimum-32-chars
API_KEY_HMAC_SECRET=dev-local-hmac-secret-32-chars-minimum
SERVICE_AUTH_SECRET=dev-local-service-auth-secret-32-chars
ENVIRONMENT=development

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jdev

# Minio
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin

# Storage
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=fabric4l
