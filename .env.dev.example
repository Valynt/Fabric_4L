# =============================================================================
# Fabric 4L - Local Development Environment
# =============================================================================
# Copy this file to `.env.dev` in the repo root and fill in the required secrets.
# This file is pre-configured for the partial dev stack:
#   frontend + layer2 + layer2.5 + layer4 + postgres + redis + neo4j + minio + keycloak
#
# Quick start:
#   cp .env.dev.example .env.dev
#   # Edit .env.dev and add your LLM API keys
#   ./scripts/dev/dev-up.sh --build
#
# Direct Compose equivalent:
#   docker compose -f infra/compose/docker-compose.dev.yml --env-file .env.dev up --build
#
# For the full platform stack, use:
#   docker compose -f infra/compose/docker-compose.full.yml --env-file .env.dev up --build
#
# WARNING: NEVER commit .env, .env.dev, or .env.generated files.
# =============================================================================

# =============================================================================
# Build-time overrides
# =============================================================================
BASE_IMAGE=python:3.11.11-slim-bookworm

# =============================================================================
# /shared - Cross-service configuration
# =============================================================================
APP_ENV=dev
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3001
INTERNAL_API_BASE_URL=http://localhost:8004
JWT_ISSUER=value-fabric-internal
JWT_AUDIENCE=value-fabric-services
TENANT_HEADER_NAME=X-Tenant-ID
REQUEST_ID_HEADER_NAME=X-Request-ID
LOG_LEVEL=info

# =============================================================================
# /infra - Infrastructure credentials (local dev defaults)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=valuefabric
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_PASSWORD=redis-local-dev-only
REDIS_URL=redis://:redis-local-dev-only@localhost:6379/0

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin

# Connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# =============================================================================
# /apps/web - Frontend runtime / build (public VITE_* only)
# =============================================================================
VITE_API_BASE_URL=http://localhost:8004
VITE_API_BASE=/api/v1
VITE_API_ROUTE_PREFIX=
VITE_L1_PREFIX=/ingest
VITE_L2_PREFIX=/extract
VITE_L2_5_PREFIX=/signals
VITE_L3_PREFIX=/graph
VITE_L4_PREFIX=/agents
VITE_L5_PREFIX=/truths
VITE_L6_PREFIX=/benchmarks
VITE_L7_PREFIX=/billing
VITE_PROXY_L1_URL=http://localhost:8001
VITE_PROXY_L2_URL=http://localhost:8002
VITE_PROXY_L3_URL=http://localhost:8003
VITE_PROXY_L4_URL=http://localhost:8004
VITE_PROXY_L5_URL=http://localhost:8005
VITE_PROXY_L6_URL=http://localhost:8006
VITE_ENABLE_CRM_SYNC=false
VITE_CRM_PROVIDER=salesforce
VITE_CRM_API_PROXY=/api/crm
VITE_ENABLE_C1_REPORTS=false
VITE_OIDC_TENANT_APPLE=apple
VITE_OIDC_TENANT_GOOGLE=google
VITE_OIDC_TENANT_MICROSOFT=microsoft
VITE_USE_MOCKS=false
VITE_ENABLE_MOCK_FALLBACK=false
VITE_ENVIRONMENT=development
VITE_APP_VERSION=local
VITE_JAEGER_ENDPOINT=http://localhost:4318/v1/traces
VITE_ENABLE_WEB_VITALS=false

# =============================================================================
# /layer1-ingestion
# =============================================================================
LAYER1_PORT=8001
LAYER1_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ingestion
LAYER1_DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/ingestion
OBJECT_STORAGE_BUCKET=fabric4l
CRAWLER_USER_AGENT=Fabric4L-Crawler/1.0
JINA_API_KEY=
INGESTION_WEBHOOK_SECRET=

# =============================================================================
# /layer2-extraction
# =============================================================================
LAYER2_PORT=8002
LAYER2_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extraction
LAYER2_DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/extraction
LLM_PROVIDER=together
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DOCUMENT_PARSE_TIMEOUT_SECONDS=60

# =============================================================================
# /layer2-5-signal-refinery
# =============================================================================
LAYER2_5_PORT=8007
LAYER2_5_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signal_refinery
SIGNAL_CONFIDENCE_THRESHOLD=0.75
SIGNAL_REFINERY_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
EVIDENCE_MATCHING_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# =============================================================================
# /layer3-knowledge
# =============================================================================
LAYER3_PORT=8003
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
GRAPH_QUERY_TIMEOUT_MS=5000
PINECONE_API_KEY=
PINECONE_INDEX=

# =============================================================================
# /layer4-agents
# =============================================================================
LAYER4_PORT=8004
LAYER4_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/layer4_agents
LAYER4_DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/layer4_agents
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/layer4_agents
LAYER4_LLM_PROVIDER=together
LAYER4_TOGETHER_API_KEY=
LAYER4_TOGETHER_BASE_URL=https://api.together.ai/v1
LAYER4_TOGETHER_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LAYER4_TOGETHER_TIMEOUT_SECONDS=60
LAYER4_WORKFLOW_TIMEOUT_SECONDS=1800
LAYER4_WORKFLOW_TIMEOUT_MIN_SECONDS=60
LAYER4_WORKFLOW_TIMEOUT_MAX_SECONDS=7200
LAYER4_WORKFLOW_TIMEOUT_FALLBACK_SECONDS=1800
AGENT_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
AGENT_MAX_RETRIES=3
LAYER4_AGENT_GATE_TIMEOUT_SECONDS=600

# =============================================================================
# /layer5-ground-truth
# =============================================================================
LAYER5_PORT=8005
LAYER5_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ground_truth
LAYER5_DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/ground_truth
VALIDATION_SIGNING_KEY=
GROUND_TRUTH_AUDIT_SECRET=

# =============================================================================
# /layer6-benchmarks
# =============================================================================
LAYER4_API_BASE_URL=http://localhost:8004
LAYER4_TIMEOUT_SECONDS=10.0
LAYER6_PORT=8006
LAYER6_API_BASE_URL=http://localhost:8006
LAYER6_TIMEOUT_SECONDS=10.0
LAYER6_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/benchmarks
LAYER6_DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/benchmarks
LAYER7_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/layer7_billing
BENCHMARK_DATASET_BUCKET=fabric4l-benchmarks
BENCHMARK_POLICY_SIGNING_KEY=

# =============================================================================
# /layer7-billing
# =============================================================================
LAYER7_PORT=8008

# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# =============================================================================
# /monitoring
# =============================================================================
PROMETHEUS_BASIC_AUTH_USER=
PROMETHEUS_BASIC_AUTH_PASSWORD=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=admin
SENTRY_DSN_BACKEND=
ALERTMANAGER_WEBHOOK_URL=

# =============================================================================
# Auth & SSO (safe defaults for local dev)
# =============================================================================
AUTH_REQUIRED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valuefabric
CORS_ORIGINS=http://localhost:3001
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# Generate secure local dev secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-local-jwt-secret-minimum-32-characters-long
DEV_SEED_ADMIN_PASSWORD=admin
DEV_SEED_ANALYST_PASSWORD=analyst
API_KEY_HMAC_SECRET=dev-local-api-key-hmac-secret-32-chars-min
SERVICE_AUTH_SECRET=dev-local-service-auth-secret-32-chars

# Per-product usage quotas (-1 = unlimited)
QUOTA_BENCHMARKS=-1
QUOTA_VALUE_DRIVERS=-1
QUOTA_VALUE_MODELS=-1
QUOTA_ASSUMPTIONS=-1
QUOTA_EVIDENCE=-1
QUOTA_CFO_NARRATIVES=-1
QUOTA_REALIZATION=-1
SUPPORTED_API_CONTRACT_VERSIONS=v1

# Generate Fernet key:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_MASTER_KEY=

# =============================================================================
# Observability (Sentry error tracking)
# =============================================================================
SENTRY_DSN=
VITE_SENTRY_DSN=

# =============================================================================
# Local Keycloak SSO/OIDC surrogate (LOCAL DEV ONLY)
# =============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fabric
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-temp-change-me-2026
KEYCLOAK_FRONTEND_CLIENT_SECRET=local-frontend-secret-only
KEYCLOAK_API_CLIENT_SECRET=local-api-secret-only
OIDC_ISSUER=http://localhost:8080/realms/fabric
OIDC_AUDIENCE=fabric-api
OIDC_JWKS_URL=http://localhost:8080/realms/fabric/protocol/openid-connect/certs
OIDC_JWKS_JSON=

# =============================================================================
# Clerk Authentication (primary IdP for production)
# =============================================================================
# The local stack uses the existing OIDC/session path. Clerk remains production-only
# unless all Clerk and Fabric auth-envelope keys below are configured.
AUTH_PROVIDER=layer4
VITE_AUTH_PROVIDER=legacy
VITE_ENABLE_MOCK_AUTH=true
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/home
VITE_CLERK_AFTER_SIGN_UP_URL=/onboarding
VITE_CLERK_JWT_TEMPLATE=valuepact-api

CLERK_ISSUER=
CLERK_JWT_AUDIENCE=fabric4l-api
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
CLERK_JWKS_URL=
CLERK_PINNED_JWT_PEM=
JWT_ALGORITHM=RS256

CLERK_SECRET_KEY=
FABRIC_AUTH_SIGNING_KEY=
FABRIC_AUTH_SIGNING_KID=gateway-k1
FABRIC_AUTH_PUBLIC_KEYS=
FABRIC_AUTH_ISSUER=fabric4l-gateway
FABRIC_AUTH_AUDIENCE=fabric4l-internal
FABRIC_AUTH_ENVELOPE_TTL_SECONDS=300
FABRIC_AUTH_SIGNING_PRIVATE_KEY=
FABRIC_AUTH_VERIFYING_PUBLIC_KEY=

CLERK_WEBHOOK_SECRET=
CLERK_WEBHOOK_RATE_LIMIT_PER_MINUTE=30

# =============================================================================
# S3-compatible Storage
# =============================================================================
STORAGE_TYPE=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=fabric4l
S3_REGION=us-east-1

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

LAYER1_S3_ACCESS_KEY=minioadmin
LAYER1_S3_SECRET_KEY=minioadmin

# =============================================================================
# E2E / Playwright Test Configuration
# =============================================================================
BACKEND_E2E_TENANT_ID=00000000-0000-4000-e2e0-000000000001
BACKEND_E2E_TENANT_BETA_ID=00000000-0000-4000-e2e0-000000000002
BACKEND_E2E_USER_ID=00000000-0000-4000-e2e0-0000000000a1
E2E_VALIDATION_ADMIN_ID=00000000-0000-4000-e2e0-000000000201
E2E_VALIDATION_REVIEWER_ID=00000000-0000-4000-e2e0-000000000202
E2E_VALIDATION_READONLY_ID=00000000-0000-4000-e2e0-000000000203
E2E_VALIDATION_SALES_ID=00000000-0000-4000-e2e0-000000000204
E2E_MERIDIAN_ACCOUNT_UUID=00000000-0000-4000-e2e0-000000000101

# =============================================================================
# Stripe Billing
# =============================================================================
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Vault HA (production only)
# =============================================================================
VAULT_AWS_REGION=us-east-1
VAULT_AWS_KMS_KEY_ID=
VAULT_IAM_ROLE_ARN=

# =============================================================================
# Infisical runtime configuration (optional - only if using Infisical SDK)
# =============================================================================
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_HOST=https://app.infisical.com
INFISICAL_SECRET_PATH=/

# =============================================================================
# Shared HTTP rate-limiting middleware tuning
# =============================================================================
RATE_LIMIT_EXEMPT_PATH_PREFIXES=/health,/metrics,/internal/health,/internal/metrics
RATE_LIMIT_KEY_INCLUDE_TENANT=true
RATE_LIMIT_KEY_INCLUDE_CALLER=true
RATE_LIMIT_KEY_INCLUDE_ROUTE=true

# =============================================================================
# Repowise (optional - local dev tooling only)
# =============================================================================
REPOWISE_API_KEY=

# =============================================================================
# Dev-only safety flags - NEVER enable in staging or production
# =============================================================================
# ALLOW_INSECURE_SERVICE_HTTP_IN_DEVELOPMENT=false
