{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run test",
        "cwd": "apps/web",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/web",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "apps/web",
        "forwardAllArgs": true
      }
    }
  }
}
