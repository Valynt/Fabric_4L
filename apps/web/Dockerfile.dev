FROM node@sha256:bde0dae02f2b12d2bce5ee72b2432f0e511767b7b2dc4dd3b064df11ae422fee
WORKDIR /workspace
RUN npm install -g corepack@latest && corepack enable

# Copy workspace manifests for pnpm --filter support
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/web/package.json ./apps/web/
COPY packages/eslint-plugin-fabric-contracts/package.json ./packages/eslint-plugin-fabric-contracts/
COPY packages/config/package.json ./packages/config/
COPY scripts/enforce-package-manager.cjs ./scripts/

# Install from workspace root
# --ignore-scripts: skip package prepare/build lifecycle scripts (e.g. eslint-plugin-fabric-contracts
# runs `tsc`, whose source is not copied into this dev image). Vite dev does not need them.
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && chown -R node:node /workspace

USER node

# Copy frontend source into its workspace location. Staying at the workspace path keeps
# pnpm's relative symlinks (../../node_modules/.pnpm/...) valid against /workspace/node_modules,
# so no symlink/copy gymnastics are needed and the anonymous node_modules volume populates
# correctly from the real symlink-farm directory.
WORKDIR /workspace/apps/web
COPY apps/web/ .

EXPOSE 3001
CMD ["pnpm", "dev"]
