{
  "uid": "fabric4l-agent-workflows",
  "title": "Fabric_4L — Agent Workflows (L4)",
  "tags": ["fabric4l", "l4", "agents", "langgraph", "workflows", "llm"],
  "schemaVersion": 39,
  "refresh": "15s",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "workflow_type",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(agent_workflow_total, workflow_type)",
        "multi": true,
        "includeAll": true,
        "current": {"text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Workflow Failures",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "increase(agent_workflow_failed_total[1m]) > 0",
        "textFormat": "Workflow failed: {{ workflow_type }}",
        "iconColor": "red"
      },
      {
        "name": "LLM Rate Limit",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "increase(llm_rate_limit_hits_total[1m]) > 0",
        "textFormat": "LLM rate limit hit: {{ provider }}",
        "iconColor": "yellow"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Workflow Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 11,
      "title": "Workflow Success Rate (SLO: 99.5%)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "slo:agent_workflow_success:ratio_7d * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 99},
              {"color": "green", "value": 99.5}
            ]
          }
        }
      },
      "options": {"graphMode": "area", "colorMode": "background", "justifyMode": "center"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}
    },
    {
      "id": 12,
      "title": "Workflows Executed (1h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(increase(agent_workflow_total[1h]))",
          "legendFormat": "Workflows",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        }
      },
      "options": {"graphMode": "area", "colorMode": "value", "justifyMode": "center"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1}
    },
    {
      "id": 13,
      "title": "Avg Workflow Duration (1h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_workflow_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "p95 Duration",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 30},
              {"color": "red", "value": 120}
            ]
          }
        }
      },
      "options": {"graphMode": "area", "colorMode": "value", "justifyMode": "center"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1}
    },
    {
      "id": 14,
      "title": "Queue Depth",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "agent_workflow_queue_depth",
          "legendFormat": "Pending",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 200}
            ]
          }
        }
      },
      "options": {"graphMode": "area", "colorMode": "background", "justifyMode": "center"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1}
    },
    {
      "id": 2,
      "title": "Workflow Performance",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "panels": []
    },
    {
      "id": 21,
      "title": "Success/Failure Rate by Workflow Type",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (workflow_type) (rate(agent_workflow_completed_total{status=\"success\"}[5m]))",
          "legendFormat": "{{ workflow_type }} — success",
          "refId": "A"
        },
        {
          "expr": "sum by (workflow_type) (rate(agent_workflow_failed_total[5m]))",
          "legendFormat": "{{ workflow_type }} — failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "drawStyle": "bars",
            "stacking": {"mode": "normal", "group": "A"},
            "spanNulls": true,
            "axisLabel": "Workflows/sec"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 6}
    },
    {
      "id": 22,
      "title": "Agent Execution Time Distribution",
      "type": "heatmap",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(rate(agent_workflow_duration_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{ le }}",
          "refId": "A"
        }
      ],
      "heatmap": {},
      "dataFormat": "tsbuckets",
      "yAxis": {
        "format": "s",
        "logBase": 10,
        "show": true,
        "max": 300
      },
      "tooltip": {"show": true, "showHistogram": true},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 6}
    },
    {
      "id": 3,
      "title": "LLM Usage & Cost",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "panels": []
    },
    {
      "id": 31,
      "title": "LLM Token Usage by Provider",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (provider, token_type) (rate(llm_tokens_total[5m]))",
          "legendFormat": "{{ provider }} — {{ token_type }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "drawStyle": "line",
            "stacking": {"mode": "normal", "group": "A"},
            "spanNulls": true,
            "axisLabel": "Tokens/sec"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}
    },
    {
      "id": 32,
      "title": "LLM API Cost ($/hr with trend)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "business:llm_cost_per_hour",
          "legendFormat": "Cost/hour",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(business:llm_cost_per_hour[24h])",
          "legendFormat": "24h Avg",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "hue",
            "spanNulls": true,
            "axisLabel": "Cost ($/hr)"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17}
    },
    {
      "id": 4,
      "title": "Checkpoint & Recovery",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "panels": []
    },
    {
      "id": 41,
      "title": "Checkpoint Save/Recovery Count",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (operation) (rate(agent_checkpoint_operations_total[5m]))",
          "legendFormat": "{{ operation }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": true,
            "axisLabel": "Operations/sec"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26}
    },
    {
      "id": 42,
      "title": "Checkpoint Recovery Time Distribution",
      "type": "heatmap",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(rate(agent_checkpoint_recovery_duration_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{ le }}",
          "refId": "A"
        }
      ],
      "heatmap": {},
      "dataFormat": "tsbuckets",
      "yAxis": {
        "format": "s",
        "logBase": 10,
        "show": true,
        "max": 60
      },
      "tooltip": {"show": true, "showHistogram": true},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26}
    },
    {
      "id": 5,
      "title": "Queue & Processing",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "panels": []
    },
    {
      "id": 51,
      "title": "Workflow Queue Depth & Processing Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "agent_workflow_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "A"
        },
        {
          "expr": "sum(rate(agent_workflow_completed_total[5m]))",
          "legendFormat": "Processing Rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "A"},
            "properties": [
              {"id": "unit", "value": "short"},
              {"id": "custom.axisLabel", "value": "Queue Depth"}
            ]
          },
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "unit", "value": "reqps"},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.axisLabel", "value": "Workflows/sec"}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 35}
    },
    {
      "id": 52,
      "title": "Worker Pool Utilization",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "agent_worker_pool_active / agent_worker_pool_size",
          "legendFormat": "Pool Utilization",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.9}
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "hue",
            "spanNulls": true,
            "axisLabel": "Utilization"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 43}
    },
    {
      "id": 53,
      "title": "Workflow Step Duration Breakdown",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_workflow_step_duration_seconds_bucket[5m])) by (le, step_name))",
          "legendFormat": "{{ step_name }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": true,
            "axisLabel": "Duration (s)"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 43}
    }
  ]
}
