{
  "uid": "fabric4l-tenant-isolation",
  "title": "Fabric_4L — Tenant Isolation & Security",
  "tags": ["fabric4l", "security", "tenant-isolation", "compliance", "rls"],
  "schemaVersion": 39,
  "refresh": "10s",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(http_requests_total, tenant_id)",
        "multi": true,
        "includeAll": true,
        "current": {"text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Tenant Breach Alerts",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "increase(cross_tenant_access_attempts_total[1m]) > 0",
        "textFormat": "TENANT BREACH: {{ source_tenant }} -> {{ target_tenant }}",
        "iconColor": "red"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Security Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 11,
      "title": "Cross-Tenant Access Attempts (CRITICAL)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(increase(cross_tenant_access_attempts_total[1m]))",
          "legendFormat": "Attempts (1m)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "options": {"graphMode": "area", "colorMode": "background", "justifyMode": "center"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 1}
    },
    {
      "id": 12,
      "title": "RLS Policy Enforcement Rate",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(rate(rls_policy_enforcement_total[5m]))",
          "legendFormat": "Policies/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        }
      },
      "options": {"graphMode": "area", "colorMode": "value", "justifyMode": "center"},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 1}
    },
    {
      "id": 13,
      "title": "Auth Failure Rate",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(rate(authentication_failures_total[5m]))",
          "legendFormat": "Failures/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          }
        }
      },
      "options": {"graphMode": "area", "colorMode": "background", "justifyMode": "center"},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 1}
    },
    {
      "id": 2,
      "title": "Tenant Activity",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "panels": []
    },
    {
      "id": 21,
      "title": "Per-Tenant Request Volume (Top 20)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(20, sum by (tenant_id) (rate(http_requests_total[5m])))",
          "legendFormat": "{{ tenant_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "drawStyle": "bars",
            "stacking": {"mode": "normal", "group": "A"},
            "spanNulls": true,
            "axisLabel": "Requests/sec"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 7}
    },
    {
      "id": 22,
      "title": "Per-Tenant Error Rate Comparison (%)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(20, (sum by (tenant_id) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (tenant_id) (rate(http_requests_total[5m]))) * 100 > 0)",
          "legendFormat": "{{ tenant_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "axisLabel": "Error %"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 7}
    },
    {
      "id": 23,
      "title": "Tenant Error Rate Distribution (Bar Chart)",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(20, (sum by (tenant_id) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (tenant_id) (rate(http_requests_total[5m]))) * 100)",
          "legendFormat": "{{ tenant_id }}",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "axisLabel": "Error Rate %"
          }
        }
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 45,
        "legend": {"displayMode": "hidden"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}
    },
    {
      "id": 24,
      "title": "Authentication Failure Rate by Type",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (failure_type) (rate(authentication_failures_total[5m]))",
          "legendFormat": "{{ failure_type }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "drawStyle": "line",
            "stacking": {"mode": "normal", "group": "A"},
            "spanNulls": true,
            "axisLabel": "Failures/sec"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17}
    },
    {
      "id": 3,
      "title": "RLS & Data Access",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "panels": []
    },
    {
      "id": 31,
      "title": "RLS Policy Enforcement Rate Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (policy_name) (rate(rls_policy_enforcement_total[5m]))",
          "legendFormat": "{{ policy_name }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": true,
            "axisLabel": "Policies enforced/sec"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26}
    },
    {
      "id": 32,
      "title": "RLS Policy Violation Attempts",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (policy_name, tenant_id, source_ip) (increase(rls_policy_violation_attempts_total[1h])) > 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Value": false},
            "renameByName": {
              "tenant_id": "Tenant (hashed)",
              "policy_name": "RLS Policy",
              "source_ip": "Source IP",
              "Value": "Violations (1h)"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Violations (1h)"},
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "yellow", "value": 1},
                    {"color": "red", "value": 5}
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": [{"displayName": "Violations (1h)", "desc": true}]},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26}
    },
    {
      "id": 33,
      "title": "Cross-Tenant Breach Timeline (Last 24h)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (source_tenant, target_tenant) (increase(cross_tenant_access_attempts_total[1h]))",
          "legendFormat": "{{ source_tenant }} -> {{ target_tenant }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "drawStyle": "points",
            "pointSize": 6,
            "spanNulls": false,
            "axisLabel": "Breach attempts"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right"},
        "tooltip": {"mode": "multi"}
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 34}
    }
  ]
}
