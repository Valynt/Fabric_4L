{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "id": "grafana",
      "name": "Grafana",
      "version": ""
    },
    {
      "id": "datasource",
      "name": "Datasource",
      "version": "1.0.0"
    },
    {
      "id": "panel",
      "name": "Panel",
      "version": ""
    },
    {
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "System health: service uptime, auth failures, worker/queue depth across L1-L7.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Service Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Health Status by Service",
      "type": "stat",
      "targets": [
        {
          "expr": "layer1_health_status",
          "legendFormat": "L1 {{component}}"
        },
        {
          "expr": "layer5_health_status",
          "legendFormat": "L5 {{component}}"
        },
        {
          "expr": "layer6_health_status",
          "legendFormat": "L6 {{service}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "Blackbox Probe Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "probe_http_duration_seconds",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Auth Failures",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "title": "Auth Failure Rate (L1)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (rate(layer1_auth_failures_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "title": "Auth Failure Rate (L5/L6)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (rate(layer5_auth_failures_total[5m]))",
          "legendFormat": "L5 {{reason}}"
        },
        {
          "expr": "sum by (reason) (rate(layer6_auth_failures_total[5m]))",
          "legendFormat": "L6 {{reason}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 102,
      "title": "Workers & Queues",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "id": 5,
      "title": "Celery Workers Active (L1)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "layer1_celery_workers_active",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "id": 6,
      "title": "Celery Queue Depth (L1)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "layer1_celery_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 103,
      "title": "Errors",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "id": 7,
      "title": "Error Rate by Service",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (error_type, component) (rate(layer1_errors_total[5m]))",
          "L1 {{error_type}}/{{component}}"
        },
        {
          "expr": "sum by (error_type, component) (rate(layer5_errors_total[5m]))",
          "legendFormat": "L5 {{error_type}}/{{component}}"
        },
        {
          "expr": "sum by (error_type, component) (rate(layer6_errors_total[5m]))",
          "legendFormat": "L6 {{error_type}}/{{component}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["system", "workers", "auth", "value-fabric"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Value Fabric — System & Workers",
  "uid": "vf-system-workers",
  "version": 1
}
