{
  "contract_version": 1,
  "owner": "sre",
  "source": "docs/operating/slos.md",
  "recording_rules": "monitoring/prometheus/recording-rules.yml",
  "alerting_rules": "monitoring/prometheus/alerting-rules.yml",
  "dashboards": [
    "monitoring/grafana/dashboards/slo-detailed.json",
    "monitoring/grafana/dashboards/slo-error-budget-burn-rate.json"
  ],
  "dashboard_metrics": [
    "value_fabric_slo_availability_ratio",
    "value_fabric_slo_latency_threshold_ms",
    "value_fabric_slo_error_budget_remaining_ratio",
    "value_fabric_slo_error_budget_consumed_total",
    "value_fabric_slo_compliance_status"
  ],
  "burn_rate_alerts": ["SLOBurnRateFast", "SLOBurnRateSlow"],
  "slos": [
    {
      "id": "api_availability",
      "name": "API Availability",
      "target": 0.999,
      "window": "30d",
      "severity": "critical",
      "primary_record": "slo:api_availability:ratio_30d",
      "burn_rate_record": "slo:api_availability:burn_rate",
      "alert": "HighErrorRate"
    },
    {
      "id": "api_latency",
      "name": "API Latency (p95)",
      "target": "p95 < 200ms",
      "window": "7d",
      "severity": "critical",
      "primary_record": "slo:api_latency:p95_7d",
      "burn_rate_record": "slo:api_latency:burn_rate",
      "alert": "HighLatency"
    },
    {
      "id": "agent_workflow_success",
      "name": "Agent Workflow Success Rate",
      "target": 0.995,
      "window": "7d",
      "severity": "high",
      "primary_record": "slo:agent_workflow_success:ratio_7d",
      "burn_rate_record": "slo:agent_workflow_success:burn_rate",
      "alert": "WorkflowFailureRateHigh"
    },
    {
      "id": "tenant_isolation",
      "name": "Tenant Isolation Enforcement",
      "target": 1.0,
      "window": "real-time",
      "severity": "critical",
      "primary_record": "slo:tenant_isolation:breach_rate_1m",
      "burn_rate_record": "slo:tenant_isolation:breach_rate_5m",
      "alert": "TenantIsolationBreached"
    },
    {
      "id": "ingestion_throughput",
      "name": "Data Ingestion Throughput",
      "target": "10000 docs/hr",
      "window": "1d",
      "severity": "medium",
      "primary_record": "slo:ingestion_throughput:docs_per_hour_1d",
      "burn_rate_record": "slo:ingestion_throughput:burn_rate",
      "alert": "IngestionThroughputLow"
    },
    {
      "id": "frontend_lcp",
      "name": "Frontend LCP",
      "target": "p75 < 2.5s",
      "window": "7d",
      "severity": "medium",
      "primary_record": "slo:frontend_lcp:p75_7d",
      "burn_rate_record": "slo:frontend_lcp:burn_rate",
      "alert": "FrontendLCPDegraded"
    }
  ]
}
