# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Environment variables
# Real .env files with secrets are never committed.
# Committed files: .env.example, .env.test, .env.staging, .env.production,
#                  .env.development, .env.production.example
.env
.env.dev
.env.local
.env.live
.env.*.local
.env.e2e-local
.env.generated
.env.generated.*
.env.clerk-production
.infisical-token
.local/secrets/
.local/**/*.env

# Bunnyshell CLI binary
.bunny/

# Bunnyshell generated import files (vars.env / secrets.env) — never commit
.bns/

# Kubernetes secrets (use External Secrets Operator in production)
k8s/secrets.yml

# Logs
*.log
logs/

# Temporary files
tmp/
*.tmp
/tmp/
.pytest-tmp/

# Test artifacts
.pytest_cache/
pytest-cache-files-*/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Playwright / E2E test outputs (traces, screenshots, videos, reports)
**/e2e-results/
**/playwright-report/
**/blob-report/
**/.playwright-artifacts*/

# CI runtime artifacts — keep directory skeleton, ignore generated files
artifacts/*
artifacts/**/*
!artifacts/*/
!artifacts/*/.gitkeep

# Locked/permission-denied CI scratch directory; cannot be deleted, so ignore it
artifacts/pytest-check-alembic/

# Node.js (if used at root)
node_modules/
.pnpm-store/

# Python artifacts at root
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
.venv/
.venv-docs/
venv/

# Python artifacts in all subdirectories (ensures no __pycache__ anywhere)
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Docker data volumes
postgres_data/
redis_data/
minio_data/
neo4j_data/

# SQLite databases
*.db
*.db-journal
*.sqlite
*.sqlite3

# Kubernetes secrets (never commit real credentials)
k8s/secrets.yml
k8s/secrets.yaml
k8s/*-secret.yml
k8s/*-secret.yaml

# Build artifacts
/build/
dist/
downloads/
eggs/
/lib/
/lib64/

# CI/Security evidence artifacts (generated during runs)
artifacts/zero-trust/
artifacts/backup-drill/
artifacts/performance/

# Generated Docker Compose artifact — produced by docker compose config
compose-resolved.yml
.env.dev

# Additional cache directories (cleanup Phase 2)
.ruff_cache/
.vite/
test-results/

# Generated files directory (most generated output should not be tracked)
generated/
!apps/web/src/api/generated/
!apps/web/src/api/generated/*.ts
!packages/platform-contract/src/typescript/generated/
!packages/platform-contract/src/typescript/generated/*.ts
!contracts/event-catalog/generated/
!contracts/event-catalog/generated/*.json
!contracts/tool-manifests/generated/
!contracts/tool-manifests/generated/*.json

# Committed Python SDK OpenAPI clients (generated, but part of the published interface)
!sdk/python/src/valuefabric/generated/
!sdk/python/src/valuefabric/generated/**/*.py

# Root-level generated outputs (conservative cleanup)
valuepacks_output.txt
audit_violations.txt
audit-output/

# Windows shortcuts
*.lnk

# Certificate files
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12

# Credential files
credentials.json
token.json

# Private folders
legal/
tax/
private/

# Archived frontend snapshots/backups (non-runtime)
# Stale archive subtrees that are no longer tracked
archive/prototypes/**
archive/testsprite-legacy/**
apps/web/src/*.backup.*
apps/web/coverage/

# Test artifacts
*_test_out.txt
*_test_summary.txt

# Layer 4 agent collection outputs
services/layer4-agents/collect_errors.txt
services/layer4-agents/collect_out*.txt

# Generated agent operational memory — not reproducible, not source code
.agent/memory/episodic/
# Staged candidate lessons are host-agent operational state (absolute runner
# paths, session timestamps); they are not durable repository knowledge.
.agent/memory/candidates/*.json
!.agent/memory/candidates/graduated/

# Temporary drift/migration baseline files
tmp_*_findings.json
tmp_*_after_fix.json
tmp_gen_migration_baseline.py


# Windows reserved-device artifact accidentally created by shell redirection
/nul
/NUL

# Windows path artifacts (CUsers* / C:Users* filenames from shell redirection on Windows)
CUsers*
cUsers*
C:Users*
c:Users*
*Users*Fabric_4L.env

# Temporary diff/patch files in repo root
/tmp_pr*.txt
/tmp_pr*.*
/tmp_models_content.txt

# Generated ZIP archives (Kimi, export artifacts, etc.)
/*.zip

# Local test output artifacts
/test_results_*.txt
/collect_output.txt
/pytest_collect*.txt
/layer1_test_results*.txt
# Core dumps (root only; do not ignore legitimate source directories named core)
/core

# Accidental local installer artifacts (do not commit)
/Codex Installer.exe
/Microsoft.Services.Store.winmd

