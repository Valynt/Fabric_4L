# Layer 2.5 Signal Refinery — local environment template
#
# Infisical paths for local development:
#   infisical run --env=dev --path=/shared --path=/infra --path=/layer2-5-signal-refinery -- <cmd>
#
# Copy to .env and fill real values only if you do not have Infisical CLI access.
# Never commit .env files.

LAYER2_5_PORT=8007
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signal_refinery
REDIS_URL=redis://localhost:6379/0
SIGNAL_CONFIDENCE_THRESHOLD=0.75
SIGNAL_REFINERY_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
EVIDENCE_MATCHING_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
