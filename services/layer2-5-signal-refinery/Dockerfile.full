# Root-context build for full/live compose stacks.
FROM python:3.11-slim@sha256:f5cf0344c9886ff24d34797578d5d7dd6e8911ae0fe5962bb55d0f89603ec361 AS builder

LABEL maintainer="Value Fabric Engineering"
LABEL description="Layer 2.5 — Signal Refinery Service"

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.11.6

WORKDIR /app

COPY services/layer2-5-signal-refinery/pyproject.toml services/layer2-5-signal-refinery/uv.lock ./
RUN uv sync --frozen --no-install-project

COPY services/layer2-5-signal-refinery/src/ ./src/
COPY services/layer2-5-signal-refinery/alembic.ini ./
COPY packages/shared/src/value_fabric/shared/ ./value_fabric/shared/

FROM python:3.11-slim@sha256:f5cf0344c9886ff24d34797578d5d7dd6e8911ae0fe5962bb55d0f89603ec361 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appgroup && useradd -r -g appgroup -m appuser

# Upgrade base-image setuptools/wheel to remediate known CVEs flagged by Trivy
RUN pip install --no-cache-dir --upgrade setuptools wheel

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app:/app/src

COPY services/layer2-5-signal-refinery/src/ ./src/
COPY services/layer2-5-signal-refinery/alembic.ini ./
COPY packages/shared/src/value_fabric/shared/ ./value_fabric/shared/

RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8007

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8007/health || exit 1

CMD ["uvicorn", "layer2_5_signal_refinery.api.main:app", "--host", "0.0.0.0", "--port", "8007"]
