# Layer 3 Knowledge Graph — local environment template
#
# Infisical paths for local development:
#   infisical run --env=dev --path=/shared --path=/infra --path=/layer3-knowledge -- <cmd>
#
# Copy to .env and fill real values only if you do not have Infisical CLI access.
# Never commit .env files.

LAYER3_PORT=8003
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_QUERY_TIMEOUT_MS=5000
PINECONE_API_KEY=
PINECONE_INDEX=
