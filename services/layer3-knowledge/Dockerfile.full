# syntax=docker/dockerfile:1
# Root-context build for full/live compose stacks.
FROM python:3.11.13-slim-bookworm AS builder

WORKDIR /app
ENV UV_TORCH_BACKEND=cpu
RUN pip install --no-cache-dir uv
COPY services/layer3-knowledge/pyproject.toml services/layer3-knowledge/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

FROM python:3.11.13-slim-bookworm

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/.venv /app/.venv
RUN pip install --no-cache-dir uv

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app:/app/src \
    UVICORN_CMD="uvicorn value_fabric.layer3.api.main:app --host 0.0.0.0 --port 8001"

COPY services/layer3-knowledge/src/ ./src/
COPY value_fabric/ ./value_fabric/
COPY packages/shared/src/value_fabric/shared/ ./value_fabric/shared/
COPY services/layer3-knowledge/src/ ./value_fabric/layer3/

RUN groupadd -r appgroup && useradd -r -g appgroup -m appuser && chown -R appuser:appgroup /app
USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["uvicorn", "value_fabric.layer3.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
