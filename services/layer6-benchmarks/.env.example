# Layer 6 Benchmarks — local environment template
#
# Infisical paths for local development:
#   infisical run --env=dev --path=/shared --path=/infra --path=/layer6-benchmarks -- <cmd>
#
# Copy to .env and fill real values only if you do not have Infisical CLI access.
# Never commit .env files.

LAYER6_PORT=8006
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/benchmarks
BENCHMARK_DATASET_BUCKET=fabric4l-benchmarks
BENCHMARK_POLICY_SIGNING_KEY=
