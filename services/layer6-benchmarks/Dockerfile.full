# Root-context build for full/live compose stacks.
FROM python:3.11-slim@sha256:d1e9ca7c4e78d1e8ecadb5d44bfc8e956e7a65b659a9950f569f243d72b326d0 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY services/layer6-benchmarks/pyproject.toml services/layer6-benchmarks/uv.lock ./
RUN uv sync --frozen --no-install-project

RUN uv pip install "sqlalchemy>=2.0" "pyjwt>=2.8.0" "redis>=5.0"

COPY services/layer6-benchmarks/src/ ./src/
COPY packages/shared/src/value_fabric/ ./value_fabric/
COPY packages/shared/src/value_fabric/shared/ ./value_fabric/shared/
COPY services/layer6-benchmarks/src/ ./value_fabric/layer6/

FROM python:3.11-slim@sha256:d1e9ca7c4e78d1e8ecadb5d44bfc8e956e7a65b659a9950f569f243d72b326d0 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appgroup && useradd -r -g appgroup -m appuser

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app:/app/src

COPY services/layer6-benchmarks/src/ ./src/
COPY packages/shared/src/value_fabric/ ./value_fabric/
COPY packages/shared/src/value_fabric/shared/ ./value_fabric/shared/
COPY services/layer6-benchmarks/src/ ./value_fabric/layer6/
COPY contracts/observability/layer6-metrics.json /contracts/observability/layer6-metrics.json

RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8006

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8006/health || exit 1

CMD ["python", "-m", "uvicorn", "layer6_benchmarks.api.main:app", "--host", "0.0.0.0", "--port", "8006"]
