# Layer 2 Extraction Pipeline — local environment template
#
# Infisical paths for local development:
#   infisical run --env=dev --path=/shared --path=/infra --path=/layer2-extraction -- <cmd>
#
# Copy to .env and fill real values only if you do not have Infisical CLI access.
# Never commit .env files.

LAYER2_PORT=8002
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/extraction
REDIS_URL=redis://localhost:6379/1
LLM_PROVIDER=together
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DOCUMENT_PARSE_TIMEOUT_SECONDS=60

# Celery configuration for async task processing
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
