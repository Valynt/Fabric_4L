# Layer 1 Ingestion Service — local environment template
#
# Infisical paths for local development:
#   infisical run --env=dev --path=/shared --path=/infra --path=/layer1-ingestion -- <cmd>
#
# Copy to .env and fill real values only if you do not have Infisical CLI access.
# Never commit .env files.

LAYER1_PORT=8001
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ingestion
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_BUCKET=fabric4l
CRAWLER_USER_AGENT=Fabric4L-Crawler/1.0
JINA_API_KEY=
INGESTION_WEBHOOK_SECRET=
