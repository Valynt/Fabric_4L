# Layer 5 Ground Truth — local environment template
#
# Infisical paths for local development:
#   infisical run --env=dev --path=/shared --path=/infra --path=/layer5-ground-truth -- <cmd>
#
# Copy to .env and fill real values only if you do not have Infisical CLI access.
# Never commit .env files.

LAYER5_PORT=8005
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ground_truth
VALIDATION_SIGNING_KEY=
GROUND_TRUTH_AUDIT_SECRET=
