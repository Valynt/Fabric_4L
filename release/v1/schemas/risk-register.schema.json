{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fabric4l.dev/release/v1/schemas/risk-register.schema.json",
  "title": "Canonical Production-Readiness Risk Register",
  "description": "Schema for production-readiness/risk_register.yaml, the single canonical machine-readable risk ledger. production-readiness/risk_register.md is a generated/checked human view; release/v1 does not carry a second register.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_date_utc", "risks"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_date_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "severity", "owner", "status", "risk", "validation", "exit_criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^PRR-[0-9]{3}$" },
          "area": { "type": "string", "minLength": 2 },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "owner": { "type": "string", "minLength": 2 },
          "status": { "enum": ["OPEN", "CLOSED", "ACCEPTED", "WAIVED"] },
          "status_note": { "type": "string" },
          "risk": { "type": "string", "minLength": 10 },
          "validation": { "type": "string", "minLength": 5 },
          "exit_criteria": { "type": "string", "minLength": 10 },
          "waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approved_by", "reference", "expires"],
            "properties": {
              "approved_by": { "type": "string", "minLength": 2 },
              "reference": { "type": "string", "minLength": 2 },
              "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
            }
          },
          "tasks": {
            "type": "array",
            "items": { "type": "string", "pattern": "^V1-[A-Z0-9]+-[0-9]{3}$" }
          }
        },
        "if": {
          "properties": { "status": { "const": "WAIVED" } }
        },
        "then": {
          "required": ["id", "area", "severity", "owner", "status", "risk", "validation", "exit_criteria", "waiver"]
        }
      }
    }
  }
}
