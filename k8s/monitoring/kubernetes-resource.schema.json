{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kubernetes Resource",
  "description": "Permissive local schema for Kubernetes manifests and CRDs in offline editor environments.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
