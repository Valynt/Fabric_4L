# Layer 4 database credentials for primary and checkpoint databases
# Used by: k8s/base/layer4-agents.yml (LAYER4_DATABASE_URL, CHECKPOINT_DATABASE_URL)
apiVersion: v1
kind: Secret
metadata:
  name: layer4-database-secret
  namespace: value-fabric
  labels:
    value-fabric.io/environment: dev
  annotations:
    value-fabric.io/warning: "For local development only. Do not use in production."
type: Opaque
stringData:
  database-url: "postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/layer4_agents"
  checkpoint-database-url: "postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/layer4_agents"
---
# Layer 5 database credentials (async and sync URLs)
# Used by: k8s/base/layer5-ground-truth.yml (DATABASE_URL, DATABASE_URL_SYNC)
apiVersion: v1
kind: Secret
metadata:
  name: layer5-database-secret
  namespace: value-fabric
  labels:
    value-fabric.io/environment: dev
  annotations:
    value-fabric.io/warning: "For local development only. Do not use in production."
type: Opaque
stringData:
  database-url: "postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/ground_truth"
  database-url-sync: "postgresql+psycopg2://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/ground_truth"
---
