{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/agents/events/workflow-completed@1.0.0.schema.json",
  "title": "WorkflowCompleted",
  "description": "Payload schema for agents.workflow.completed.v1: an agentic workflow has reached a terminal success state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "workflow_run_id", "workflow_type", "status", "completed_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the workflow run" },
    "workflow_run_id": { "type": "string", "minLength": 1, "description": "Workflow run identifier" },
    "workflow_type": { "type": "string", "description": "Workflow type" },
    "status": { "type": "string", "description": "Terminal status: completed" },
    "output_ids": { "type": "array", "items": { "type": "string" }, "description": "Generated output artifact identifiers" },
    "completed_at": { "type": "string", "format": "date-time", "description": "ISO 8601 completion timestamp" }
  }
}