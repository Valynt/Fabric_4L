{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/agents/events/checkpoint-created@1.0.0.schema.json",
  "title": "CheckpointCreated",
  "description": "Payload schema for agents.checkpoint.created.v1: a workflow checkpoint has been created.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "workflow_run_id", "checkpoint_id", "created_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the workflow run" },
    "workflow_run_id": { "type": "string", "minLength": 1, "description": "Workflow run identifier" },
    "checkpoint_id": { "type": "string", "minLength": 1, "description": "Checkpoint identifier" },
    "checkpoint_type": { "type": "string", "description": "graph_state or message_state" },
    "node_name": { "type": "string", "description": "Workflow node at which the checkpoint was taken" },
    "created_at": { "type": "string", "format": "date-time", "description": "ISO 8601 creation timestamp" }
  }
}