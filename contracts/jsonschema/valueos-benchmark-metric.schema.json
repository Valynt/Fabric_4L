{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/valueos-benchmark-metric.schema.json",
  "title": "ValueOSBenchmarkMetric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_id",
    "slug",
    "display_name",
    "description",
    "unit",
    "taxonomy",
    "segmentation",
    "distribution",
    "provenance",
    "governance"
  ],
  "properties": {
    "metric_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_pillar",
        "functional_domain",
        "category",
        "lifecycle_stage",
        "value_type"
      ],
      "properties": {
        "value_pillar": {
          "type": "string",
          "minLength": 1
        },
        "functional_domain": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_stage": {
          "type": "string",
          "enum": ["prospect", "onboarding", "expansion", "renewal", "justify_commit", "realize_expand"]
        },
        "value_type": {
          "type": "string",
          "enum": ["cost_reduction", "cost_savings", "revenue_growth", "revenue_uplift", "risk_mitigation"]
        }
      }
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["industry", "company_size_band", "geography"],
      "properties": {
        "industry": {
          "type": "string",
          "enum": ["technology", "financial_services", "healthcare", "manufacturing", "retail"]
        },
        "company_size_band": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "maturity_band": {
          "type": "string"
        },
        "revenue_band": {
          "type": "string"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p10", "p25", "p50", "p75", "p90", "mean", "sample_size"],
      "properties": {
        "p10": {
          "type": "number"
        },
        "p25": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        },
        "std_dev": {
          "type": "number",
          "minimum": 0
        },
        "sample_size": {
          "type": "integer",
          "minimum": 1
        },
        "shape": {
          "type": "string",
          "enum": ["normal", "lognormal", "skewed_left", "skewed_right", "bimodal", "unknown"]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_name",
          "source_type",
          "publication_year",
          "license_class",
          "ingested_at",
          "confidence_score"
        ],
        "properties": {
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": ["public_benchmark", "licensed_research", "regulatory_filing", "academic_study", "proprietary_survey", "customer_outcome"]
          },
          "publication_year": {
            "type": "integer",
            "minimum": 1990
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license_class": {
            "type": "string",
            "enum": ["public", "internal", "licensed_restricted", "partner_anonymized"]
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time"
          },
          "extraction_method": {
            "type": "string"
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "vintage", "status", "owner"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "vintage": {
          "type": "string",
          "pattern": "^\\d{4}(?:Q[1-4])?$"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "deprecated", "rejected"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "stale_after": {
          "type": "string",
          "format": "date"
        },
        "deprecation_reason": {
          "type": "string"
        }
      }
    }
  }
}
