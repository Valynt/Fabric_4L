{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/billing/events/dispute-opened@1.0.0.schema.json",
  "title": "DisputeOpened",
  "description": "Payload schema for billing.dispute.opened.v1: a payment dispute has been opened.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "billing_account_id", "dispute_id", "payment_id", "opened_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the dispute" },
    "billing_account_id": { "type": "string", "minLength": 1, "description": "Billing account identifier" },
    "dispute_id": { "type": "string", "minLength": 1, "description": "Dispute identifier" },
    "payment_id": { "type": "string", "minLength": 1, "description": "Original payment identifier" },
    "reason_code": { "type": "string", "description": "Dispute reason code" },
    "opened_at": { "type": "string", "format": "date-time", "description": "ISO 8601 open timestamp" }
  }
}