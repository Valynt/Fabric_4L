{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/billing/events/invoice-paid@1.0.0.schema.json",
  "title": "InvoicePaid",
  "description": "Payload schema for billing.invoice.paid.v1: an invoice has been successfully paid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "billing_account_id", "invoice_id", "paid_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the invoice" },
    "billing_account_id": { "type": "string", "minLength": 1, "description": "Billing account identifier" },
    "invoice_id": { "type": "string", "minLength": 1, "description": "Invoice identifier" },
    "payment_id": { "type": "string", "description": "Payment identifier" },
    "amount_cents": { "type": "integer", "minimum": 0, "description": "Amount paid in cents" },
    "paid_at": { "type": "string", "format": "date-time", "description": "ISO 8601 payment timestamp" }
  }
}