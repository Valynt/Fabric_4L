{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/billing/events/billing-account-created@1.0.0.schema.json",
  "title": "BillingAccountCreated",
  "description": "Payload schema for billing.account.created.v1: a billing account has been provisioned for a tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "billing_account_id", "currency", "created_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the billing account" },
    "billing_account_id": { "type": "string", "minLength": 1, "description": "Billing account identifier" },
    "currency": { "type": "string", "minLength": 3, "description": "ISO 4217 currency code" },
    "timezone": { "type": "string", "description": "Billing timezone" },
    "created_at": { "type": "string", "format": "date-time", "description": "ISO 8601 creation timestamp" }
  }
}