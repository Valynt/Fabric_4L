{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/identity/events/user-registered@1.0.0.schema.json",
  "title": "UserRegistered",
  "description": "Payload schema for identity.user.registered.v1: a new user account has been created.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "user_id", "email", "registered_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the user" },
    "user_id": { "type": "string", "minLength": 1, "description": "New user identifier" },
    "email": { "type": "string", "format": "email", "description": "User email address" },
    "provisioning": { "type": "string", "description": "Provisioning status: pending_verification or active" },
    "registered_at": { "type": "string", "format": "date-time", "description": "ISO 8601 registration timestamp" }
  }
}