{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/identity/events/user-updated@1.0.0.schema.json",
  "title": "UserUpdated",
  "description": "Payload schema for identity.user.updated.v1: an existing user account has been updated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "user_id", "updated_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the user" },
    "user_id": { "type": "string", "minLength": 1, "description": "Updated user identifier" },
    "changed_fields": { "type": "array", "items": { "type": "string" }, "description": "Fields changed in this update" },
    "updated_at": { "type": "string", "format": "date-time", "description": "ISO 8601 update timestamp" }
  }
}