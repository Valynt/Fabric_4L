{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/identity/events/password-changed@1.0.0.schema.json",
  "title": "PasswordChanged",
  "description": "Payload schema for identity.password.changed.v1: a user's password has been changed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "user_id", "changed_by", "changed_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the user" },
    "user_id": { "type": "string", "minLength": 1, "description": "User whose password changed" },
    "changed_by": { "type": "string", "minLength": 1, "description": "user for self-change, admin principal for reset" },
    "changed_at": { "type": "string", "format": "date-time", "description": "ISO 8601 change timestamp" }
  }
}