{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/identity/events/session-revoked@1.0.0.schema.json",
  "title": "SessionRevoked",
  "description": "Payload schema for identity.session.revoked.v1: a session has been revoked before its natural expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "session_id", "user_id", "revoked_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the session" },
    "session_id": { "type": "string", "minLength": 1, "description": "Revoked session identifier" },
    "user_id": { "type": "string", "minLength": 1, "description": "Session owner" },
    "revocation_reason": { "type": "string", "description": "Reason: logout, password_change, admin_revoke" },
    "revoked_at": { "type": "string", "format": "date-time", "description": "ISO 8601 revocation timestamp" }
  }
}