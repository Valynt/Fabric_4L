{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuefabric.ai/contracts/jsonschema/knowledge/events/entity-updated@1.0.0.schema.json",
  "title": "EntityUpdated",
  "description": "Payload schema for knowledge.entity.updated.v1: an existing entity has been updated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "entity_id", "entity_type", "updated_at"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "description": "Tenant that owns the entity" },
    "entity_id": { "type": "string", "minLength": 1, "description": "Updated entity identifier" },
    "entity_type": { "type": "string", "description": "Entity type" },
    "changed_fields": { "type": "array", "items": { "type": "string" }, "description": "Fields changed in this update" },
    "source_run_id": { "type": "string", "description": "Source run that triggered the update" },
    "updated_at": { "type": "string", "format": "date-time", "description": "ISO 8601 update timestamp" }
  }
}