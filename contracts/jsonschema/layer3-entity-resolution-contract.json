{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://valuefabric.dev/contracts/layer3/entity-resolution-contract.json",
  "title": "Layer3EntityResolutionContract",
  "type": "object",
  "required": [
    "canonical_entity_id",
    "confidence",
    "tie_break_rule",
    "source_evidence_ids",
    "tie_break_evidence",
    "reasoning_trace_keys"
  ],
  "properties": {
    "canonical_entity_id": {
      "type": ["string", "null"],
      "description": "Canonical selected entity ID for resolution outcome"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tie_break_rule": {
      "type": "string",
      "description": "Tie-break strategy applied or fallback marker"
    },
    "source_evidence_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tie_break_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "updated_at", "reference_count"],
        "properties": {
          "entity_id": {"type": "string"},
          "updated_at": {"type": ["string", "null"]},
          "reference_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "reasoning_trace_keys": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
