{
  "$schema": "../schemas/agent-contract.schema.json",
  "id": "crm-sync-agent-contract",
  "version": "1.0.0",
  "kind": "agent_contract",
  "owner": "@layer4-agents",
  "risk_class": "high",
  "description": "Operating contract for the CRMSyncAgent.",
  "agent_type": "CRMSyncAgent",
  "tools": [
    "export_to_crm",
    "update_opportunity",
    "validate_input",
    "semantic_search",
    "get_entity"
  ],
  "memory_scopes": [
    "working"
  ],
  "permissions": {
    "read_paths": [
      "services/layer3-knowledge/",
      "contracts/agent-registry/"
    ],
    "write_paths": [
      "contracts/integration-schemas/"
    ],
    "network": [
      "external"
    ],
    "isolation_level": "tenant_strict"
  },
  "eval_target": {
    "suite_id": "crm-sync-eval",
    "min_score": 0.0,
    "required_capabilities": [
      "sync_accounts",
      "sync_opportunities"
    ]
  },
  "compatibility": {
    "supported_prior_versions": [],
    "migration_notes": "Initial operating contract."
  },
  "observability": {
    "required_trace_fields": [
      "tenant_id",
      "trace_id",
      "agent_type",
      "capability"
    ],
    "required_metrics": [
      "agent_run_total",
      "agent_run_latency_ms"
    ],
    "audit_events": [
      "agent_started",
      "agent_completed"
    ]
  },
  "governance": {
    "review_requirement": "Layer 4 + Platform Contracts + Security review for external network or isolation changes.",
    "approval_threshold": "One Layer 4 reviewer and one Platform Contracts reviewer.",
    "rollout_policy": "Validation runs in warning mode before runtime enforcement.",
    "deprecation_policy": "Keep previous contract version until all consumers migrate."
  }
}
