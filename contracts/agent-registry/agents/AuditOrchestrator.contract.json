{
  "$schema": "../schemas/agent-contract.schema.json",
  "id": "audit-orchestrator-contract",
  "version": "1.0.0",
  "kind": "agent_contract",
  "owner": "@layer4-agents",
  "risk_class": "critical",
  "description": "Operating contract for the AuditOrchestrator.",
  "agent_type": "AuditOrchestrator",
  "tools": [
    "audit_ai_systems",
    "audit_compliance",
    "audit_infrastructure",
    "audit_performance",
    "semantic_search",
    "get_entity"
  ],
  "memory_scopes": [
    "working",
    "semantic"
  ],
  "permissions": {
    "read_paths": [
      ".agent/",
      "contracts/agent-registry/",
      "docs/",
      "services/"
    ],
    "write_paths": [
      ".audit_cache/",
      "audit_reports/"
    ],
    "network": [
      "internal_only"
    ],
    "isolation_level": "tenant_strict"
  },
  "eval_target": {
    "suite_id": "audit-orchestrator-eval",
    "min_score": 0.0,
    "required_capabilities": [
      "run_full_audit",
      "get_sprint_plan"
    ]
  },
  "compatibility": {
    "supported_prior_versions": [],
    "migration_notes": "Initial operating contract."
  },
  "observability": {
    "required_trace_fields": [
      "tenant_id",
      "trace_id",
      "agent_type",
      "capability",
      "run_id"
    ],
    "required_metrics": [
      "agent_run_total",
      "agent_run_latency_ms"
    ],
    "audit_events": [
      "agent_started",
      "agent_completed"
    ]
  },
  "governance": {
    "review_requirement": "Layer 4 + Platform Contracts + Security review for any change.",
    "approval_threshold": "Two Layer 4 reviewers and one Platform Contracts reviewer.",
    "rollout_policy": "Validation runs in warning mode before runtime enforcement.",
    "deprecation_policy": "Keep previous contract version until all consumers migrate."
  }
}
