{
  "$schema": "../schemas/agent-contract.schema.json",
  "id": "integrity-agent-contract",
  "version": "1.0.0",
  "kind": "agent_contract",
  "owner": "@layer4-agents",
  "risk_class": "regulated",
  "description": "Operating contract for the IntegrityAgent.",
  "agent_type": "IntegrityAgent",
  "tools": [
    "validate_input",
    "assess_drift",
    "audit_compliance",
    "audit_ai_systems",
    "semantic_search",
    "get_entity"
  ],
  "memory_scopes": [
    "working",
    "semantic"
  ],
  "permissions": {
    "read_paths": [
      "services/layer5-ground-truth/",
      "contracts/agent-registry/"
    ],
    "write_paths": [],
    "network": [
      "internal_only"
    ],
    "isolation_level": "tenant_strict"
  },
  "eval_target": {
    "suite_id": "integrity-eval",
    "min_score": 0.0,
    "required_capabilities": [
      "validate_claims",
      "verify_formulas"
    ]
  },
  "compatibility": {
    "supported_prior_versions": [],
    "migration_notes": "Initial operating contract."
  },
  "observability": {
    "required_trace_fields": [
      "tenant_id",
      "trace_id",
      "agent_type",
      "capability"
    ],
    "required_metrics": [
      "agent_run_total",
      "agent_run_latency_ms"
    ],
    "audit_events": [
      "agent_started",
      "agent_completed"
    ]
  },
  "governance": {
    "review_requirement": "Layer 4 + Platform Contracts + Governance review for tool or isolation changes.",
    "approval_threshold": "One Layer 4 reviewer and one Platform Contracts reviewer.",
    "rollout_policy": "Validation runs in warning mode before runtime enforcement.",
    "deprecation_policy": "Keep previous contract version until all consumers migrate."
  }
}
