{
  "$schema": "../schemas/agent-contract.schema.json",
  "id": "orchestration-controller-contract",
  "version": "1.0.0",
  "kind": "agent_contract",
  "owner": "@layer4-agents",
  "risk_class": "critical",
  "description": "Operating contract for the OrchestrationController.",
  "agent_type": "OrchestrationController",
  "tools": [
    "create_task",
    "find_paths",
    "graph_traverse",
    "semantic_search",
    "get_entity"
  ],
  "memory_scopes": [
    "working",
    "episodic",
    "semantic"
  ],
  "permissions": {
    "read_paths": [
      "services/layer4-agents/",
      "contracts/agent-registry/"
    ],
    "write_paths": [
      "services/layer4-agents/state/"
    ],
    "network": [
      "internal_only"
    ],
    "isolation_level": "tenant_strict"
  },
  "eval_target": {
    "suite_id": "orchestration-eval",
    "min_score": 0.0,
    "required_capabilities": [
      "schedule_workflow",
      "assign_agent"
    ]
  },
  "compatibility": {
    "supported_prior_versions": [],
    "migration_notes": "Initial operating contract."
  },
  "observability": {
    "required_trace_fields": [
      "tenant_id",
      "trace_id",
      "agent_type",
      "capability"
    ],
    "required_metrics": [
      "agent_run_total",
      "agent_run_latency_ms"
    ],
    "audit_events": [
      "agent_started",
      "agent_completed"
    ]
  },
  "governance": {
    "review_requirement": "Layer 4 + Platform Contracts + Architecture review for any change.",
    "approval_threshold": "Two Layer 4 reviewers and one Platform Contracts reviewer.",
    "rollout_policy": "Validation runs in warning mode before runtime enforcement.",
    "deprecation_policy": "Keep previous contract version until all consumers migrate."
  }
}
