  "components": {
    "schemas": {
      "ExtractAndIngestResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "overall_status": {
            "type": "string",
            "title": "Overall Status"
          },
          "extraction_status": {
            "type": "string",
            "title": "Extraction Status"
          },
          "ingestion_status": {
            "type": "string",
            "title": "Ingestion Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "overall_status",
          "extraction_status",
          "ingestion_status",
          "message"
        ],
        "title": "ExtractAndIngestResponse",
        "description": "Response for combined extract-and-ingest endpoint."
      },
      "ExtractRequest": {
        "properties": {
          "content_id": {
            "type": "string",
            "title": "Content Id",
            "description": "ID of content to extract from (from Layer 1)"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "description": "URL of source document"
          },
          "markdown_content": {
            "type": "string",
            "title": "Markdown Content",
            "description": "Markdown content to extract from"
          },
          "extraction_config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extraction Config"
          }
        },
        "type": "object",
        "required": [
          "content_id",
          "source_url",
          "markdown_content"
        ],
        "title": "ExtractRequest",
        "description": "Request body for extraction endpoint."
      },
      "ExtractResponse": {
        "properties": {
          "extraction_job_id": {
            "type": "string",
            "title": "Extraction Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "extraction_job_id",
          "status",
          "message"
        ],
        "title": "ExtractResponse",
        "description": "Response from extraction endpoint."
      },
      "ExtractionStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "overall_status": {
            "type": "string",
            "title": "Overall Status"
          },
          "extraction_status": {
            "type": "string",
            "title": "Extraction Status"
          },
          "ingestion_status": {
            "type": "string",
            "title": "Ingestion Status"
          },
          "entities_extracted": {
            "type": "integer",
            "title": "Entities Extracted"
          },
          "relationships_extracted": {
            "type": "integer",
            "title": "Relationships Extracted"
          },
          "retry_count": {
            "type": "integer",
            "title": "Retry Count",
            "default": 0
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "next_retry_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Retry At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "overall_status",
          "extraction_status",
          "ingestion_status",
          "entities_extracted",
          "relationships_extracted",
          "completed_at"
        ],
        "title": "ExtractionStatusResponse",
        "description": "Status of a combined extraction + ingestion pipeline job."
      },
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Machine-readable error code"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message"
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "description": "Request ID for support correlation"
              },
              "details": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Optional sanitized error details"
              }
            }
          }
        },
        "description": "Deprecated compatibility alias for ErrorEnvelope. Use ErrorEnvelope for new clients."
      },
      "OperationalSignalLifecycleRecord": {
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1,
            "title": "Signal Id"
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Tenant Id"
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "title": "Account Id"
          },
          "status": {
            "$ref": "#/components/schemas/SignalLifecycleStatus",
            "default": "active"
          },
          "lineage": {
            "$ref": "#/components/schemas/SignalLineage"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/SignalLifecycleMetadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "signal_id",
          "tenant_id",
          "account_id",
          "lifecycle"
        ],
        "title": "OperationalSignalLifecycleRecord"
      },
      "SignalLifecycleActor": {
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "title": "Actor Id"
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "title": "Account Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor_id",
          "account_id"
        ],
        "title": "SignalLifecycleActor"
      },
      "SignalLifecycleMetadata": {
        "properties": {
          "created_by": {
            "$ref": "#/components/schemas/SignalLifecycleActor"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_by": {
            "$ref": "#/components/schemas/SignalLifecycleActor"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "created_by",
          "updated_by"
        ],
        "title": "SignalLifecycleMetadata"
      },
      "SignalLifecycleStatus": {
        "type": "string",
        "enum": [
          "active",
          "superseded",
          "merged"
        ],
        "title": "SignalLifecycleStatus"
      },
      "SignalLineage": {
        "properties": {
          "supersedes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supersedes"
          },
          "superseded_by": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Superseded By"
          },
          "merged_into": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merged Into"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SignalLineage"
      },
      "TransitionRequest": {
        "properties": {
