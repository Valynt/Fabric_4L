              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Machine-readable error code"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message"
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "description": "Request ID for support correlation"
              },
              "details": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": true
                  },
