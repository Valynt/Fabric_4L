    "/v1/extract/jobs/{job_id}/events": {
      "get": {
        "summary": "Stream Job Events",
        "description": "Stream real-time events for a pipeline job via SSE.\n\nReturns a Server-Sent Events stream with progress updates,\nstatus changes, entity discovery, and log messages.\n\nEvent types:\n- `progress`: Extraction progress percentage (0-100)\n- `status`: Job status changes (pending, running, completed, failed)\n- `log`: Pipeline log messages with timestamp and level\n- `entity`: Newly discovered entities during extraction\n- `complete`: Job completion event\n- `error`: Error event with details\n\nArgs:\n    job_id: The pipeline job ID to stream events for\n\nReturns:\n    StreamingResponse with text/event-stream content type",
        "operationId": "stream_job_events_v1_extract_jobs__job_id__events_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
