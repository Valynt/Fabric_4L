{
  "openapi": "3.1.0",
  "info": {
    "title": "Layer 2.5: Signal Refinery",
    "description": "Turns L2 extraction output into trusted, evidence-backed ValueSignal objects. Provides CRUD, review, promote, and refinement endpoints.",
