                "$ref": "#/components/schemas/SignalPromoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Promote Signal Api V1 Signals  Signal Id  Promote Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals/refine": {
      "post": {
        "tags": [
          "signals"
        ],
        "summary": "Refine Signals",
        "description": "Trigger L2.5 refinement on a batch of raw L2 extraction payloads.\n\nAccepts ``raw_signals`` (preferred) \u2014 actual L2 extraction output \u2014 or\nfalls back to ``source_refs`` for backward compatibility. The fallback\nproduces signals with synthetic content and should not be used in production.",
        "operationId": "refine_signals_api_v1_signals_refine_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignalRefineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Refine Signals Api V1 Signals Refine Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Machine-readable error code"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message"
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "description": "Request ID for support correlation"
              },
              "details": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Optional sanitized error details"
              }
            }
          }
        },
        "description": "Deprecated compatibility alias for ErrorEnvelope. Use ErrorEnvelope for new clients."
      },
      "ProvenanceExtractor": {
        "type": "string",
        "enum": [
          "human",
          "ai",
          "system"
        ],
        "title": "ProvenanceExtractor"
      },
      "RawSignalInput": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Raw signal type from L2 (mapped to ValueSignalType by refinery)",
            "default": "pain"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Evidence"
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance"
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Refs"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "content",
          "confidence"
        ],
        "title": "RawSignalInput",
        "description": "A single raw signal payload from L2 extraction, passed to the /refine endpoint.\n\nCallers should supply the actual extracted content and provenance rather than\nletting the refinery synthesise placeholder values."
      },
      "SignalImpactArea": {
        "type": "string",
        "enum": [
          "revenue",
          "cost",
          "risk",
          "strategic"
        ],
        "title": "SignalImpactArea"
      },
      "SignalPromoteRequest": {
        "properties": {
          "value_path_category": {
            "type": "string",
            "title": "Value Path Category",
            "description": "Value path: revenue_uplift, cost_savings, risk_reduction, blended"
          },
          "value_driver_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Driver Id"
          }
        },
        "type": "object",
        "required": [
          "value_path_category"
        ],
        "title": "SignalPromoteRequest",
        "description": "Request body for promoting a signal to a hypothesis."
      },
      "SignalRefineRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "raw_signals": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/RawSignalInput"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Signals",
            "description": "Actual L2 extraction payloads to refine. Preferred over source_refs."
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Refs"
          },
          "extraction_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extraction Run Id"
          }
        },
        "type": "object",
        "required": [
          "account_id"
        ],
        "title": "SignalRefineRequest",
        "description": "Request body for triggering L2.5 refinement on L2 extraction output.\n\nPrefer ``raw_signals`` to pass actual L2 extraction payloads.\n``source_refs`` alone is accepted for backward compatibility but produces\nsignals with synthetic content and should not be used in production."
      },
      "SignalReviewRequest": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ValueSignalLifecycleState",
            "description": "Must be 'validated' or 'rejected'"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "SignalReviewRequest",
        "description": "Request body for human review of a signal."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValueSignalCreate": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "type": {
            "$ref": "#/components/schemas/ValueSignalType"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "trust_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Trust Score",
            "default": 0.0
          },
          "lifecycle_state": {
            "$ref": "#/components/schemas/ValueSignalLifecycleState",
            "default": "draft"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/ValueSignalEvidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "evidence_chunk_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Evidence Chunk Ids"
          },
          "provenance": {
            "$ref": "#/components/schemas/ValueSignalProvenance"
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Refs"
          },
          "opportunity_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opportunity Id"
          },
          "value_driver_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Driver Id"
          },
          "stakeholder_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stakeholder Id"
          },
          "persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Persona"
          },
          "industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          },
          "impact_area": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SignalImpactArea"
              },
              {
                "type": "null"
              }
            ]
          },
          "estimated_value": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Value"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "time_horizon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Horizon"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "type",
          "content",
          "confidence",
          "provenance"
        ],
        "title": "ValueSignalCreate",
        "description": "Request body for creating a new ValueSignal.\n\ntenant_id is NOT accepted here \u2014 it is always set from authenticated context."
      },
