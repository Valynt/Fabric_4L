        ],
        "summary": "Promote Signal",
        "operationId": "promote_signal_api_v1_signals__signal_id__promote_post",
        "parameters": [
          {
            "name": "signal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Signal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
