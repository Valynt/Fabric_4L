# valuepact Environment Template
#
# This file is a path-annotated reference that mirrors the Infisical secret
# structure. For the canonical secrets management guide, see:
#   docs/security/secrets-management.md
#
# Local development uses Infisical CLI to inject secrets at runtime:
#   infisical run --env=dev --path=/shared --path=/infra --path=/layerN -- <cmd>
#
# If you do not have Infisical CLI access, copy this file to .env and fill
# real values manually. Never commit .env or .env.generated files.

# =============================================================================
# Build-time overrides
# =============================================================================
# Override the private GHCR base image used by Dockerfiles for local dev.
# When unset, docker-compose.full.yml defaults to python:3.11.11-slim-bookworm.
BASE_IMAGE=python:3.11.11-slim-bookworm

# =============================================================================
# /shared  —  Cross-service configuration
# =============================================================================
APP_ENV=dev
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3001
INTERNAL_API_BASE_URL=http://localhost:8004
JWT_ISSUER=value-fabric-internal
JWT_AUDIENCE=value-fabric-services
TENANT_HEADER_NAME=X-Tenant-ID
REQUEST_ID_HEADER_NAME=X-Request-ID
LOG_LEVEL=info

# =============================================================================
# /infra  —  Infrastructure credentials (local dev defaults shown)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=valuefabric
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=<CHANGE_ME_IN_LOCAL_ENV>
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY_ID=<CHANGE_ME_IN_LOCAL_ENV>
MINIO_SECRET_ACCESS_KEY=<CHANGE_ME_IN_LOCAL_ENV>

# Connection pool tuning (used by Layer 1 sync database)
# Layer 4 and Layer 5 use service-specific pool settings in their config
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# =============================================================================
# /apps/web  —  Frontend runtime / build (public VITE_* only)
# =============================================================================
VITE_API_BASE_URL=http://localhost:8004
VITE_API_BASE=/api/v1
# Route prefix for the unified API gateway. Empty string means the gateway is mounted at VITE_API_BASE.
VITE_API_ROUTE_PREFIX=
VITE_L1_PREFIX=/ingest
VITE_L2_PREFIX=/extract
VITE_L2_5_PREFIX=/signals
VITE_L3_PREFIX=/graph
VITE_L4_PREFIX=/agents
VITE_L5_PREFIX=/truths
VITE_L6_PREFIX=/benchmarks
VITE_PROXY_L1_URL=http://localhost:8001
VITE_PROXY_L2_URL=http://localhost:8002
VITE_PROXY_L3_URL=http://localhost:8003
VITE_PROXY_L4_URL=http://localhost:8004
VITE_PROXY_L5_URL=http://localhost:8005
VITE_PROXY_L6_URL=http://localhost:8006
VITE_ENABLE_CRM_SYNC=false
VITE_CRM_PROVIDER=salesforce
VITE_CRM_API_PROXY=/api/crm
VITE_ENABLE_C1_REPORTS=false
VITE_OIDC_TENANT_APPLE=apple
VITE_OIDC_TENANT_GOOGLE=google
VITE_OIDC_TENANT_MICROSOFT=microsoft
VITE_USE_MOCKS=false
VITE_ENABLE_MOCK_FALLBACK=false
VITE_ENVIRONMENT=development
VITE_APP_VERSION=local
VITE_JAEGER_ENDPOINT=http://localhost:4318/v1/traces
# Web vitals are enabled automatically for staging/production; set true to opt in locally.
VITE_ENABLE_WEB_VITALS=false

# =============================================================================
# /layer1-ingestion
# =============================================================================
# NOTE: LAYERn_PORT variables are HOST ports for local direct access (e.g., when
# running a service natively with uvicorn or when the frontend proxies directly
# to localhost). Docker Compose maps container port 8000 to these host ports.
LAYER1_PORT=8001
LAYER1_DATABASE_URL=postgresql://user:password@localhost:5432/ingestion
LAYER1_DATABASE_URL_SYNC=postgresql+psycopg://user:password@localhost:5432/ingestion
IDEMPOTENCY_TTL_SECONDS=3600
OBJECT_STORAGE_BUCKET=fabric4l
CRAWLER_USER_AGENT=Fabric4L-Crawler/1.0
JINA_API_KEY=
INGESTION_WEBHOOK_SECRET=

# =============================================================================
# /layer2-extraction
# =============================================================================
LAYER2_PORT=8002
LAYER2_DATABASE_URL=postgresql://user:password@localhost:5432/extraction
LAYER2_DATABASE_URL_SYNC=postgresql+psycopg://user:password@localhost:5432/extraction
LLM_PROVIDER=together
TOGETHER_API_KEY=
OPENAI_API_KEY=<SET_IF_USING_OPENAI>
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DOCUMENT_PARSE_TIMEOUT_SECONDS=60

# =============================================================================
# /layer2-5-signal-refinery
# =============================================================================
LAYER2_5_PORT=8007
LAYER2_5_DATABASE_URL=postgresql://user:password@localhost:5432/signal_refinery
SIGNAL_CONFIDENCE_THRESHOLD=0.75
SIGNAL_REFINERY_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
EVIDENCE_MATCHING_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# =============================================================================
# /layer3-knowledge
# =============================================================================
LAYER3_PORT=8003
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
GRAPH_QUERY_TIMEOUT_MS=5000
PINECONE_API_KEY=
PINECONE_INDEX=

# =============================================================================
# /layer4-agents
# =============================================================================
LAYER4_PORT=8004
LAYER4_DATABASE_URL=postgresql://user:password@localhost:5432/layer4_agents
LAYER4_DATABASE_URL_SYNC=postgresql+psycopg://user:password@localhost:5432/layer4_agents
CHECKPOINT_DATABASE_URL=postgresql://user:password@localhost:5432/layer4_agents
# Legacy alias (deprecated): LANGGRAPH_CHECKPOINT_DB_URL=postgresql://user:password@localhost:5432/layer4_agents
LAYER4_LLM_PROVIDER=together
LAYER4_TOGETHER_API_KEY=
LAYER4_TOGETHER_BASE_URL=https://api.together.ai/v1
LAYER4_TOGETHER_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LAYER4_TOGETHER_TIMEOUT_SECONDS=60
LAYER4_WORKFLOW_TIMEOUT_SECONDS=1800
LAYER4_WORKFLOW_TIMEOUT_MIN_SECONDS=60
LAYER4_WORKFLOW_TIMEOUT_MAX_SECONDS=7200
LAYER4_WORKFLOW_TIMEOUT_FALLBACK_SECONDS=1800
AGENT_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
AGENT_MAX_RETRIES=3
LAYER4_AGENT_GATE_TIMEOUT_SECONDS=600

# =============================================================================
# /layer5-ground-truth
# =============================================================================
LAYER5_PORT=8005
LAYER5_DATABASE_URL=postgresql://user:password@localhost:5432/ground_truth
LAYER5_DATABASE_URL_SYNC=postgresql+psycopg://user:password@localhost:5432/ground_truth
VALIDATION_SIGNING_KEY=
GROUND_TRUTH_AUDIT_SECRET=

# =============================================================================
# /layer6-benchmarks
# =============================================================================
LAYER4_API_BASE_URL=http://localhost:8004
LAYER4_TIMEOUT_SECONDS=10.0
LAYER6_PORT=8006
LAYER6_API_BASE_URL=http://localhost:8006
LAYER6_TIMEOUT_SECONDS=10.0
LAYER6_DATABASE_URL=postgresql://user:password@localhost:5432/benchmarks
LAYER6_DATABASE_URL_SYNC=postgresql+psycopg://user:password@localhost:5432/benchmarks
BENCHMARK_DATASET_BUCKET=fabric4l-benchmarks
BENCHMARK_POLICY_SIGNING_KEY=


# Flower (Celery monitoring) credentials for local full-stack dev
FLOWER_USER=admin
FLOWER_PASSWORD=<CHANGE_ME_IN_LOCAL_ENV>

# =============================================================================
# /monitoring
# =============================================================================
PROMETHEUS_BASIC_AUTH_USER=
PROMETHEUS_BASIC_AUTH_PASSWORD=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_IN_LOCAL_ENV>
SENTRY_DSN_BACKEND=
ALERTMANAGER_WEBHOOK_URL=

# =============================================================================
# /ci  —  CI-specific tokens (fallback when OIDC is unavailable)
# =============================================================================
DOCKER_REGISTRY=ghcr.io
GHCR_USERNAME=
GHCR_PAT=
CODECOV_TOKEN=

# Infisical path: /shared/auth
# =============================================================================
# Auth & SSO (required in all non-dev environments; safe defaults for local)
# =============================================================================
AUTH_REQUIRED=true
DATABASE_URL=postgresql://user:password@localhost:5432/valuefabric
CORS_ORIGINS=http://localhost:3001
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
# Generate secure local dev secrets (do not commit generated values):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<GENERATE_YOUR_OWN>
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_ANALYST_PASSWORD=
API_KEY_HMAC_SECRET=<GENERATE_YOUR_OWN>
SERVICE_AUTH_SECRET=<GENERATE_YOUR_OWN>
# Per-product usage quotas. -1 means unlimited. Values are enforced by the gateway.
QUOTA_BENCHMARKS=-1
QUOTA_VALUE_DRIVERS=-1
QUOTA_VALUE_MODELS=-1
QUOTA_ASSUMPTIONS=-1
QUOTA_EVIDENCE=-1
QUOTA_CFO_NARRATIVES=-1
QUOTA_REALIZATION=-1
# Comma-separated list of API contract versions the gateway accepts.
SUPPORTED_API_CONTRACT_VERSIONS=v1
# 256-bit base64-encoded Fernet key for application-level field encryption.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_MASTER_KEY=

# Infisical path: /monitoring
# =============================================================================
# Observability (Sentry error tracking)
# =============================================================================
# Backend services SENTRY_DSN (shared across all Python services)
SENTRY_DSN=
# Frontend Sentry DSN (Vite exposes only VITE_* vars to the browser bundle)
VITE_SENTRY_DSN=
# Infisical path: /shared/auth
# ---------------------------------------------------------------------------
# Local Keycloak SSO/OIDC surrogate (LOCAL DEV ONLY — never use these defaults in production)
# ---------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fabric
KEYCLOAK_ADMIN_USER=admin
# Local dev-only bootstrap password. Must be changed in any environment that holds real data.
KEYCLOAK_ADMIN_PASSWORD=local-admin-temp-change-me-2026
# Public client used by the React frontend; secret is not required for PKCE/public flow.
KEYCLOAK_FRONTEND_CLIENT_SECRET=local-frontend-secret-only
# Confidential client used by backend service-account / bearer validation in local dev.
KEYCLOAK_API_CLIENT_SECRET=local-api-secret-only
OIDC_ISSUER=http://localhost:8080/realms/fabric
OIDC_AUDIENCE=fabric-api
OIDC_JWKS_URL=http://localhost:8080/realms/fabric/protocol/openid-connect/certs
OIDC_JWKS_JSON=

# =============================================================================
# Clerk Authentication (primary IdP for production)
# =============================================================================
# Infisical path: /shared/auth  (gateway auth mode)
AUTH_PROVIDER=clerk

# Infisical path: /apps/web  (frontend-safe, shipped in browser bundle)
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=
# Optional non-VITE alias for Docker Compose secret managers. Compose maps this
# into VITE_CLERK_PUBLISHABLE_KEY for browser builds; do not read it in frontend code.
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/home
VITE_CLERK_AFTER_SIGN_UP_URL=/onboarding
VITE_CLERK_JWT_TEMPLATE=fabric4l-api

# Infisical path: /shared/auth  (backend gateway auth config)
CLERK_ISSUER=
CLERK_JWT_AUDIENCE=fabric4l-api
# Localhost-only default. Staging and production values (e.g., https://www.valuepact.ai,
# https://api.valuepact.ai) MUST be injected by Infisical; never commit real hostnames here.
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
CLERK_JWKS_URL=https://accounts.valuepact.ai/.well-known/jwks.json
# Optional pinned PEM for local/testing environments to bypass Clerk JWKS fetch.
CLERK_PINNED_JWT_PEM=
JWT_ALGORITHM=RS256

# Infisical path: /shared/auth  (API gateway auth-plane secrets)
CLERK_SECRET_KEY=
FABRIC_AUTH_SIGNING_KEY=
FABRIC_AUTH_SIGNING_KID=gateway-k1
FABRIC_AUTH_PUBLIC_KEYS=
FABRIC_AUTH_ISSUER=fabric4l-gateway
FABRIC_AUTH_AUDIENCE=fabric4l-internal
FABRIC_AUTH_ENVELOPE_TTL_SECONDS=300
# Backward-compatible aliases accepted by the API gateway while older secret
# stores are being migrated. Prefer the canonical names above.
FABRIC_AUTH_SIGNING_PRIVATE_KEY=
FABRIC_AUTH_VERIFYING_PUBLIC_KEY=

# Infisical path: /layer1-ingestion through /layer6-benchmarks
# Downstream services only need the Fabric4L internal verification key:
# FABRIC_AUTH_PUBLIC_KEYS=
# FABRIC_AUTH_ISSUER=fabric4l-gateway
# FABRIC_AUTH_AUDIENCE=fabric4l-internal
# FABRIC_AUTH_MODE=observe

# Infisical path: /shared/auth  (Clerk webhook verification)
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk webhook IP rate limit (requests per minute). Increase only if Clerk docs recommend higher.
CLERK_WEBHOOK_RATE_LIMIT_PER_MINUTE=30

# Infisical path: /infra
# =============================================================================
# S3-compatible Storage
# =============================================================================
STORAGE_TYPE=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=fabric4l
S3_REGION=us-east-1

# MinIO local dev credentials — DO NOT USE IN PRODUCTION
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Layer 1 S3/MinIO credentials — local dev only
LAYER1_S3_ACCESS_KEY=minioadmin
LAYER1_S3_SECRET_KEY=minioadmin

# Infisical path: /shared
# =============================================================================
# E2E / Playwright Test Configuration (safe local defaults)
# =============================================================================
BACKEND_E2E_TENANT_ID=00000000-0000-4000-e2e0-000000000001
BACKEND_E2E_TENANT_BETA_ID=00000000-0000-4000-e2e0-000000000002
BACKEND_E2E_USER_ID=00000000-0000-4000-e2e0-0000000000a1
E2E_VALIDATION_ADMIN_ID=00000000-0000-4000-e2e0-000000000201
E2E_VALIDATION_REVIEWER_ID=00000000-0000-4000-e2e0-000000000202
E2E_VALIDATION_READONLY_ID=00000000-0000-4000-e2e0-000000000203
E2E_VALIDATION_SALES_ID=00000000-0000-4000-e2e0-000000000204
E2E_MERIDIAN_ACCOUNT_UUID=00000000-0000-4000-e2e0-000000000101

# =============================================================================
# Stripe Billing
# =============================================================================
STRIPE_WEBHOOK_SECRET=

# Infisical path: /infra
# =============================================================================
# Vault HA (production only)
# =============================================================================
VAULT_AWS_REGION=us-east-1
VAULT_AWS_KMS_KEY_ID=
VAULT_IAM_ROLE_ARN=

# =============================================================================
# Infisical runtime configuration (optional — only if using Infisical SDK)
# =============================================================================
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_HOST=https://app.infisical.com
INFISICAL_SECRET_PATH=/

# Infisical path: /shared
# Shared HTTP rate-limiting middleware tuning
# Comma-separated path prefixes that bypass rate limiting by platform policy.
RATE_LIMIT_EXEMPT_PATH_PREFIXES=/health,/metrics,/internal/health,/internal/metrics
# Include tenant, caller, and endpoint classification in rate-limit keys.
RATE_LIMIT_KEY_INCLUDE_TENANT=true
RATE_LIMIT_KEY_INCLUDE_CALLER=true
RATE_LIMIT_KEY_INCLUDE_ROUTE=true

# =============================================================================
# Repowise (optional — local dev tooling only, never used at runtime)
# =============================================================================
# API key for the Repowise MCP server used by AI coding agents
# (see docs/development/REPOWISE.md). Obtain from https://docs.repowise.dev/.
REPOWISE_API_KEY=

# Infisical path: /shared
# =============================================================================
# Dev-only safety flags  —  NEVER enable in staging or production
# =============================================================================
# These flags weaken security for local development convenience. They are
# validated by ProductionSafetyValidator and will cause startup failure in
# production-like environments if enabled.
# ALLOW_INSECURE_SERVICE_HTTP_IN_DEVELOPMENT=false

# LOCAL DEV ONLY — will fail startup in production
# DEV_AUTH_BYPASS=false  # noqa: secret-hygiene-example-only
# ALLOW_DEV_AUTH_BYPASS=false  # noqa: secret-hygiene-example-only
# AUTH_BYPASS_ENABLED=false  # noqa: secret-hygiene-example-only
# ALLOW_INSECURE_DEV_AUTH_BYPASS=false  # noqa: secret-hygiene-example-only
