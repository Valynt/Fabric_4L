{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "skill_id": "invariant-driven-testing",
  "name": "invariant-driven-testing",
  "version": "1.0.0",
  "description": "Turn user workflows into testable business and security invariants through adversarial design, tenant isolation, full-stack automation, business-rule validation, failure injection, observability, environment engineering, and honest reporting.",
  "input_schema": {
    "type": "object",
    "properties": {
      "workflow": {
        "type": "string",
        "description": "The user workflow to test, e.g. 'export approved evidence'."
      },
      "target_layer": {
        "type": "string",
        "enum": ["frontend", "layer1", "layer2", "layer3", "layer4", "layer5", "layer6", "cross_layer"],
        "description": "The primary layer the workflow touches."
      },
      "scope": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "all",
            "adversarial",
            "tenant_isolation",
            "full_stack",
            "business_rules",
            "failure_injection",
            "observability",
            "environment",
            "readiness"
          ]
        },
        "default": ["all"],
        "description": "Subskills to apply. Default is all."
      },
      "severity_threshold": {
        "type": "string",
        "enum": ["P0", "P1", "P2", "P3"],
        "default": "P0",
        "description": "Minimum severity to address."
      },
      "generate_tests": {
        "type": "boolean",
        "default": true,
        "description": "If true, produce actual test files."
      },
      "report_path": {
        "type": "string",
        "default": "artifacts/testing/invariant-driven-report.md",
        "description": "Where to write the readiness report."
      }
    },
    "required": ["workflow", "target_layer"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tests_written": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Paths to test files and test names created."
      },
      "gap_matrix": {
        "type": "object",
        "description": "Table of invariants vs. subskills with status."
      },
      "verification_result": {
        "type": "string",
        "enum": ["pass", "fail", "partial"],
        "description": "Overall verification result."
      },
      "report_path": {
        "type": "string",
        "description": "Path to the readiness report."
      },
      "readiness_assessment": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": ["Go", "Conditional Go", "No-Go"]
          },
          "rationale": { "type": "string" },
          "verified_count": { "type": "integer" },
          "assumed_count": { "type": "integer" },
          "skipped_count": { "type": "integer" }
        },
        "required": ["verdict"]
      }
    }
  },
  "side_effects": "write",
  "timeout_ms": 300000,
  "required_context": ["project_graph", "test_inventory", "production_invariants"],
  "allowed_agents": ["*"]
}
