{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric/internal/schemas/authz/decision.schema.json",
  "title": "AuthzDecision",
  "type": "object",
  "required": ["schema_version", "allowed", "decision_id", "policy_version", "evaluated_at", "reason_codes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "fabric.authz.decision.v1" },
    "allowed": { "type": "boolean" },
    "decision_id": { "type": "string" },
    "policy_version": { "type": "string" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "deny_code": { "type": ["string", "null"] },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "type": "string" }, "detail": { "type": ["object", "null"] } }
      }
    },
    "bundle_digest": { "type": ["string", "null"] },
    "input_fingerprint": { "type": ["string", "null"] },
    "evaluated_at": { "type": ["string", "null"] },
    "resource_revision": { "type": ["string", "null"] },
    "cache_ttl_ms": { "type": "integer" }
  }
}