{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fabric.authz.decision.v1",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "allow",
    "reason_codes",
    "policy_version",
    "input_fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "fabric.authz.decision.v1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "allow": {
      "type": "boolean"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deny_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 32
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "cache_ttl_ms": {
      "type": "integer",
      "minimum": 0
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
